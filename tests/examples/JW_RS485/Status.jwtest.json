{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "El puerto RS-485 integrado del JWPLC Basic (Serial2, RX16/TX17 de jwplc_hardware_config.h, MAX13487E con AutoDirection) a 115200 8N1 con cola TX de 512 bytes: queda listo y sin error. El loop está vacío, así que un texto inyectado en el bus no produce salida. Desde alpha.14 el ejemplo usa un solo bus (antes mostraba un segundo bus en los GPIO25/26/27, que son TFT DC, zumbador y EN_IO).",
  "sketch": "package:libraries/JW_RS485/examples/Status",
  "until_ms": 2000,
  "stim": [
    "1500 uart2 \"HOLA\\n\""
  ],
  "expect": {
    "console": [
      "^== RS-485 ==$",
      {
        "match": "^RS485 enabled: yes$",
        "count": 1
      },
      {
        "match": "^Ready: yes$",
        "count": 1
      },
      {
        "match": "^Status: OK$",
        "count": 1
      },
      {
        "match": "^Baud: 115200$",
        "count": 1
      },
      {
        "match": "^Config: SERIAL_8N1$",
        "count": 1
      },
      {
        "match": "^RX pin: 16$",
        "count": 1
      },
      {
        "match": "^TX pin: 17$",
        "count": 1
      },
      {
        "match": "^Direction: AutoDirection$",
        "count": 1
      },
      {
        "match": "^TX buffer bytes: 512$",
        "count": 1
      },
      {
        "match": "^Queued TX supported: yes$",
        "count": 1
      },
      {
        "match": "^Last error: OK$",
        "count": 1
      }
    ],
    "console_absent": [
      "^HOLA$",
      "^== Bus [AB] ==$"
    ]
  }
}
