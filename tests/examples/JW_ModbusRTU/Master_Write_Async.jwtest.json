{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Maestro cooperativo FC06 al esclavo 2: cada 2 s después de cada resultado escribe HR1 con 1, 2, 3, 4 (plazo 1 s). Se simula el esclavo por UART2: eco a los 1,2 s (WRITE OK HR1=1) y 3,25 s (WRITE OK HR1=2); sin respuesta al tercer pedido (Timeout a ~6,25 s); excepción 02 al cuarto (Modbus exception). Por el bus salen las cuatro tramas 02 06 0001 000n con su CRC.",
  "sketch": "package:libraries/JW_ModbusRTU/examples/Master_Write_Async",
  "until_ms": 8800,
  "stim": [
    "1200 uart2 \"\\x02\\x06\\x00\\x01\\x00\\x01\\x19\\xF9\"",
    "3250 uart2 \"\\x02\\x06\\x00\\x01\\x00\\x02\\x59\\xF8\"",
    "8300 uart2 \"\\x02\\x86\\x02\\x33\\xA1\""
  ],
  "expect": {
    "console": [
      "^JW_ModbusRTU - Modbus RTU Master FC06$",
      "^Target ID=2 \\| HR1 \\| 115200 8N1$",
      {
        "match": "^\\\\x02\\\\x06\\\\x00\\\\x01\\\\x00\\\\x01\\\\x19\\\\xF9\\\\x02\\\\x06\\\\x00\\\\x01\\\\x00\\\\x02Y\\\\xF8\\\\x02\\\\x06\\\\x00\\\\x01\\\\x00\\\\x03\\\\x988\\\\x02\\\\x06\\\\x00\\\\x01\\\\x00\\\\x04\\\\xD9\\\\xFA$",
        "port": 2,
        "count": 1
      },
      {
        "match": "^WRITE OK \\| HR1=1$",
        "count": 1,
        "after_ms": 1200,
        "before_ms": 1300
      },
      {
        "match": "^WRITE OK \\| HR1=2$",
        "count": 1,
        "after_ms": 3250,
        "before_ms": 3350
      },
      {
        "match": "^WRITE OK",
        "count": 2
      },
      {
        "match": "^WRITE FAIL \\| Timeout$",
        "count": 1,
        "after_ms": 6200,
        "before_ms": 6300
      },
      {
        "match": "^WRITE FAIL \\| Modbus exception$",
        "count": 1,
        "after_ms": 8300,
        "before_ms": 8400
      },
      {
        "match": "^WRITE FAIL",
        "count": 2
      }
    ],
    "console_absent": [
      "^Request rejected",
      "begin failed"
    ]
  }
}
