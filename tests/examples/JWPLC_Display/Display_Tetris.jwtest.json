{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Corrida 1: OK en IDLE arranca el Tetris; tres caídas instantáneas (UP) fijan tres piezas sin completar líneas (Score 15, Lines 0); ESC vuelve a IDLE y el puntaje se conserva. Corrida 2: UP repetido apila piezas hasta GAME OVER (estado 2) y el juego vuelve solo a IDLE sin ESC.",
  "sketch": "package:libraries/JWPLC_Display/examples/Display_Tetris",
  "runs": [
    {
      "until_ms": 7000,
      "stim": [
        "2500 BTN_OK=1", "2600 BTN_OK=0",
        "3000 BTN_UP=1", "3100 BTN_UP=0",
        "3300 BTN_UP=1", "3400 BTN_UP=0",
        "3600 BTN_UP=1", "3700 BTN_UP=0",
        "4500 BTN_ESC=1", "4600 BTN_ESC=0"
      ],
      "expect": {
        "console": [
          "^JWPLC TFT Tetris - Optimized \\+ Buzzer$",
          "^FPS objetivo: 30$",
          "^Velocidad: 100%$",
          { "match": "^Display listo\\.$", "count": 1 },
          "^Presiona OK en IDLE para iniciar Tetris\\.$",
          { "match": "^Mode: IDLE \\| Game: 0 \\| .* \\| Score: 0 \\| Lines: 0$", "min": 1, "before_ms": 2500 },
          { "match": "^Tetris: START$", "count": 1, "after_ms": 2500, "before_ms": 2700 },
          { "match": "^Mode: USER \\| Game: 1 \\| Target FPS: 30 \\| Measured FPS: [1-9]\\d* \\| Speed: 100% \\| Score: 15 \\| Lines: 0$", "count": 1, "after_ms": 3700, "before_ms": 4500 },
          { "match": "^Tetris: retorno a IDLE$", "count": 1, "after_ms": 4500, "before_ms": 4700 },
          { "match": "^Mode: IDLE \\| Game: 0 \\| .* \\| Score: 15 \\| Lines: 0$", "min": 1, "after_ms": 4700 }
        ]
      }
    },
    {
      "until_ms": 10000,
      "stim": [
        "2500 BTN_OK=1", "2600 BTN_OK=0",
        "3000 BTN_UP=1", "3100 BTN_UP=0", "3200 BTN_UP=1", "3300 BTN_UP=0",
        "3400 BTN_UP=1", "3500 BTN_UP=0", "3600 BTN_UP=1", "3700 BTN_UP=0",
        "3800 BTN_UP=1", "3900 BTN_UP=0", "4000 BTN_UP=1", "4100 BTN_UP=0",
        "4200 BTN_UP=1", "4300 BTN_UP=0", "4400 BTN_UP=1", "4500 BTN_UP=0",
        "4600 BTN_UP=1", "4700 BTN_UP=0", "4800 BTN_UP=1", "4900 BTN_UP=0",
        "5000 BTN_UP=1", "5100 BTN_UP=0", "5200 BTN_UP=1", "5300 BTN_UP=0",
        "5400 BTN_UP=1", "5500 BTN_UP=0", "5600 BTN_UP=1", "5700 BTN_UP=0",
        "5800 BTN_UP=1", "5900 BTN_UP=0", "6000 BTN_UP=1", "6100 BTN_UP=0",
        "6200 BTN_UP=1", "6300 BTN_UP=0", "6400 BTN_UP=1", "6500 BTN_UP=0",
        "6600 BTN_UP=1", "6700 BTN_UP=0", "6800 BTN_UP=1", "6900 BTN_UP=0"
      ],
      "expect": {
        "console": [
          { "match": "^Tetris: START$", "count": 1 },
          { "match": "^Mode: USER \\| Game: 2 \\| .* \\| Score: \\d+ \\| Lines: 0$", "min": 1 },
          { "match": "^Tetris: retorno a IDLE$", "count": 1 },
          { "match": "^Mode: IDLE \\| Game: 0 \\| .* \\| Score: [1-9]\\d* \\| Lines: 0$", "min": 1, "after_ms": 7000 }
        ]
      }
    }
  ]
}
