{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Modo IDLE_RETURN_TIMEOUT (8 s): OK entra a USER; ESC no retorna en este modo y, como cualquier botón presionado, cuenta como actividad; DOWN a los 6 s vuelve a postergar el retorno, que ocurre una sola vez ~8 s después de soltarlo (no a los 8 s de entrar).",
  "sketch": "package:libraries/JWPLC_Display/examples/Display_Idle_Return_Modes",
  "until_ms": 15500,
  "stim": [
    "2500 BTN_OK=1", "2600 BTN_OK=0",
    "4000 BTN_ESC=1", "4100 BTN_ESC=0",
    "6000 BTN_DOWN=1", "6100 BTN_DOWN=0"
  ],
  "expect": {
    "console": [
      "^Display_Idle_Return_Modes$",
      "^OK=USER$",
      { "match": "^Display ready\\. Mode: IDLE_RETURN_TIMEOUT$", "count": 1 },
      { "match": "^Saliendo de USER hacia IDLE$", "count": 0, "before_ms": 13900 },
      { "match": "^Saliendo de USER hacia IDLE$", "count": 1, "after_ms": 13900, "before_ms": 14600 }
    ],
    "console_absent": ["^Retorno manual a IDLE"]
  }
}
