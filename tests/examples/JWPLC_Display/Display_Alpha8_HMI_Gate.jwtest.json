    "4400 BTN_UP=1", "4500 BTN_UP=0",
    "4800 BTN_UP=1", "4900 BTN_UP=0",
    "5200 BTN_DOWN=1", "5300 BTN_DOWN=0",
    "5600 BTN_LEFT=1", "5700 BTN_LEFT=0",
