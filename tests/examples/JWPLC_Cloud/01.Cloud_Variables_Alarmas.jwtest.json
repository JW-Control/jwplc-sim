{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "JWPLC_Cloud en JWPLC Sim. (1) Sin cable: guarda la muestra y lo dice (SIN RED) sin detener el loop; I0.0 enciende Q0.0. (2) DHCP guionado (el de 01.TLS_HTTPS_Cable); en el envío de los 11 s el sketch abre el socket 0 al servicio TLS de la PC, el guion responde OK y HTTP 200 de JW Cloud: a los 20 s imprime EN LINEA con 1 envío. El envío real a JW Cloud se prueba con cloud-dev (A19_RED_3 del package).",
  "sketch": "package:libraries/JWPLC_Cloud/examples/01.Cloud_Variables_Alarmas",
  "runs": [
    {
      "until_ms": 12000,
      "stim": [
        "2000 I0_1=1",
        "3000 I0_0=1"
      ],
      "expect": {
        "console": [
          {
            "match": "^JW Cloud: SIN RED, 0 envíos, 1 muestras esperando red$",
            "min": 1
          }
        ],
        "signals": [
          {
            "at_ms": 3500,
            "DO": "0b00000001"
          }
        ]
      }
    },
    {
      "until_ms": 21000,
      "stim": [
        "500 I0_1=1",
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 ",
        "11100 net 0 connected 192.168.250.1:4430",
        "11300 net 0 data 4f4b0a",
        "11600 net 0 data 485454502f312e3120323030204f4b0d0a436f6e74656e742d547970653a20746578742f706c61696e0d0a436f6e6e656374696f6e3a20636c6f73650d0a0d0a4f4b0a"
      ],
      "expect": {
        "console": [
          {
            "match": "^JW Cloud: EN LINEA, 1 envíos$",
            "min": 1
          }
        ]
      }
    }
  ]
}