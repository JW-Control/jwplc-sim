{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Esclavo ID 2 (115200 8N1). Un maestro simulado por UART2 lee HR0..HR3 (FC03: RX=1 TX=1, la respuesta empieza con 02 03 08), escribe HR1=1234 (FC06: el sketch muestra HR1=1234, RX=2 TX=2), manda una trama con CRC inválido (RX=3 y CRC=1, sin respuesta: TX sigue en 2) y un pedido para el ID 5 (se ignora: los contadores no cambian).",
  "sketch": "package:libraries/JWPLC_ModbusRTU/examples/01.ModbusRTU_Slave_Holding",
  "until_ms": 5500,
  "stim": [
    "1500 uart2 \"\\x02\\x03\\x00\\x00\\x00\\x04\\x44\\x3A\"",
    "2500 uart2 \"\\x02\\x06\\x00\\x01\\x04\\xD2\\x5A\\xA4\"",
    "3500 uart2 \"\\x02\\x06\\x00\\x01\\x00\\x07\\x00\\x00\"",
    "4500 uart2 \"\\x05\\x03\\x00\\x00\\x00\\x04\\x45\\x8D\""
  ],
  "expect": {
    "console": [
      "^JWPLC Basic - Modbus RTU Slave$",
      "^ID=2 \\| 115200 8N1 \\| HR0\\.\\.HR7$",
      {
        "match": "^HR0=1 HR1=100 RX=0 TX=0 CRC=0$",
        "count": 1,
        "before_ms": 1500
      },
      {
        "match": "^HR0=2 HR1=100 RX=1 TX=1 CRC=0$",
        "count": 1,
        "after_ms": 1500,
        "before_ms": 2500
      },
      {
        "match": "^HR0=3 HR1=1234 RX=2 TX=2 CRC=0$",
        "count": 1,
        "after_ms": 2500,
        "before_ms": 3500
      },
      {
        "match": "^HR0=4 HR1=1234 RX=3 TX=2 CRC=1$",
        "count": 1,
        "after_ms": 3500,
        "before_ms": 4500
      },
      {
        "match": "^HR0=5 HR1=1234 RX=3 TX=2 CRC=1$",
        "count": 1,
        "after_ms": 4500
      },
      {
        "match": "^\\\\x02\\\\x03\\\\x08",
        "port": 2,
        "count": 1
      }
    ],
    "console_absent": [
      "begin failed"
    ]
  }
}
