{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Dos arranques. (1) Cable conectado sin servidor DHCP: a los 10 s y a los 20 s el estado dice modo Ethernet, sale por Sin red y WiFi no incluida (el sketch no incluye JWPLC_WiFi.h), y no intenta conectar. (2) El servidor DHCP guionado (el mismo de 01.Ethernet_DHCP_Basic) entrega 192.168.250.10: a los 10 s sale por Ethernet con esa IP e intenta la petición HTTP.",
  "sketch": "package:libraries/JWPLC_Red/examples/02.Red_Solo_Cable",
  "runs": [
    {
      "until_ms": 21000,
      "expect": {
        "console": [
          {
            "match": "^Red: modo Ethernet \\| sale por: Sin red \\| cable: no \\| WiFi: no incluida$",
            "min": 2
          }
        ],
        "console_absent": [
          "Respuesta por",
          "No se pudo conectar"
        ]
      }
    },
    {
      "until_ms": 12000,
      "stim": [
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 "
      ],
      "expect": {
        "console": [
          {
            "match": "^Red: modo Ethernet \\| sale por: Ethernet \\| IP: 192\\.168\\.250\\.10 \\| cable: listo \\| WiFi: no incluida$",
            "min": 1,
            "after_ms": 9000
          }
        ],
        "console_absent": [
          "sale por: Sin red"
        ]
      }
    }
  ]
}
