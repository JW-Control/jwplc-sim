{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Servidor por cable: el DHCP guionado (el de 01.Ethernet_DHCP_Basic) entrega 192.168.250.10; JWPLC_RedServer escucha el puerto 80 en el socket 0 del W5500. Una visita HTTP llega al socket 0 y, tras atenderla, la siguiente al socket 1 (el servidor vuelve a escuchar): las dos se atienden por Ethernet.",
  "sketch": "package:libraries/JWPLC_Red/examples/03.Red_Servidor",
  "runs": [
    {
      "until_ms": 15000,
      "stim": [
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 ",
        "11000 net 0 connected 192.168.250.1:50123",
        "11200 net 0 data 474554202f20485454502f312e310d0a486f73743a20706c630d0a0d0a",
        "12500 net 1 connected 192.168.250.1:50124",
        "12700 net 1 data 474554202f20485454502f312e310d0a486f73743a20706c630d0a0d0a"
      ],
      "expect": {
        "console": [
          {
            "match": "^Visita 1 por Ethernet$",
            "min": 1
          },
          {
            "match": "^Visita 2 por Ethernet$",
            "min": 1
          }
        ]
      }
    }
  ]
}