{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Dos arranques con FRAM y RTC compartidos. (1) Sin servidor DHCP ni hora válida: crea el bloque FRAM (arranque #1), UP/UP/DOWN guardan y verifican 1, 2, 1, RIGHT/LEFT cambian de página; la hora inválida no enciende ERR (ERR: NINGUNO); OK con Ethernet sin IP informa 'Ethernet no esta listo' y la causa pasa a ERR: HTTP sin contar un GET. (2) RTC fijo 2026-03-15 10:30 y el servidor DHCP guionado responde OFFER y ACK (xid 0x394, el que genera el firmware con la semilla por defecto; MAC 02:4A:57:C4:0A:24) con 192.168.250.10/24, puerta de enlace y DNS 192.168.250.1: recupera el bloque (arranque #2), UP continúa desde el valor guardado (2), ETH queda OK con la IP ofrecida y OK lanza el GET a example.com; como nadie responde DNS en la red simulada, la librería espera su plazo (~15 s) y el resultado es FALLO CONNECT/DNS a los ~22 s, se cuenta 1 GET sin éxito y ERR: HTTP. Desde alpha.14 el ejemplo ya no toma el mutex SPI por fuera de la librería (hallazgo H15): con un servidor real el GET llega a HTTP 200 (scripts/diag-eth-http.mjs).",
  "sketch": "package:libraries/JWPLC_Ethernet/examples/Ethernet_HTTP_TFT_Diagnostics",
  "runs": [
    {
      "until_ms": 11000,
      "stim": [
        "2880 BTN_UP=1",
        "2980 BTN_UP=0",
        "3280 BTN_UP=1",
        "3380 BTN_UP=0",
        "3680 BTN_DOWN=1",
        "3780 BTN_DOWN=0",
        "4080 BTN_RIGHT=1",
        "4180 BTN_RIGHT=0",
        "4480 BTN_LEFT=1",
        "4580 BTN_LEFT=0",
        "5880 BTN_OK=1",
        "5980 BTN_OK=0"
      ],
      "expect": {
        "console": [
          "^JWPLC Basic - Ethernet HTTP TFT Diagnostics$",
          "^Host: http://example\\.com/$",
          {
            "match": "^FRAM: creando bloque de diagnostico$",
            "count": 1
          },
          {
            "match": "^FRAM: OK \\| Boot #1$",
            "count": 1
          },
          {
            "match": "^Display: diagnostico USER activo$",
            "count": 1
          },
          {
            "match": "^Button: UP \\| Count: 1$",
            "count": 1,
            "after_ms": 2880,
            "before_ms": 3280
          },
          {
            "match": "^FRAM value: 1 \\| guardado y verificado$",
            "count": 2
          },
          {
            "match": "^FRAM value: 2 \\| guardado y verificado$",
            "count": 1,
            "after_ms": 3280,
            "before_ms": 3680
          },
          {
            "match": "^Button: DOWN \\| Count: 1$",
            "count": 1
          },
          {
            "match": "^Button: RIGHT \\| Count: 1$",
            "count": 1,
            "after_ms": 4080,
            "before_ms": 4480
          },
          {
            "match": "^Button: LEFT \\| Count: 1$",
            "count": 1,
            "after_ms": 4480,
            "before_ms": 4880
          },
          {
            "match": "^ETH: DHCP pending \\| IP: 0\\.0\\.0\\.0 \\| RTC: HORA INVALIDA \\| FRAM: GUARDADO OK \\| HTTP: LISTO - PULSE OK \\| GET OK: 0/0 \\| ERR: NINGUNO$",
            "count": 1,
            "before_ms": 5880
          },
          {
            "match": "^Button: OK \\| Count: 1$",
            "count": 1,
            "after_ms": 5880
          },
          {
            "match": "^HTTP: Ethernet no esta listo$",
            "count": 1,
            "after_ms": 5880
          },
          {
            "match": "^ETH: DHCP failed \\| IP: 0\\.0\\.0\\.0 \\| RTC: HORA INVALIDA \\| FRAM: GUARDADO OK \\| HTTP: ETHERNET NO LISTO \\| GET OK: 0/0 \\| ERR: HTTP$",
            "count": 1,
            "after_ms": 5880
          }
        ],
        "console_absent": [
          "ERROR al guardar",
          "fallo de escritura",
          "^HTTP: GET"
        ]
      }
    },
    {
      "until_ms": 24000,
      "args": [
        "--rtc",
        "fijo:2026-03-15T10:30:00"
      ],
      "stim": [
        "2680 net 0 udp 192.168.250.1:67 ",
        "3880 net 0 udp 192.168.250.1:67 ",
        "5380 BTN_UP=1",
        "5480 BTN_UP=0",
        "6880 BTN_OK=1",
        "6980 BTN_OK=0"
      ],
      "expect": {
        "console": [
          {
            "match": "^FRAM: bloque persistente recuperado$",
            "count": 1
          },
          {
            "match": "^FRAM: OK \\| Boot #2$",
            "count": 1
          },
          {
            "match": "^FRAM value: 2 \\| guardado y verificado$",
            "count": 1,
            "after_ms": 5380,
            "before_ms": 6880
          },
          {
            "match": "^HTTP: GET http://example\\.com/$",
            "count": 1,
            "after_ms": 6880
          },
          {
            "match": "^=== Resultado HTTP ===$",
            "count": 1,
            "after_ms": 20000
          },
          {
            "match": "^Estado: FALLO CONNECT/DNS$",
            "count": 1,
            "after_ms": 20000
          },
          {
            "match": "^Bytes: 0$",
            "count": 1,
            "after_ms": 20000
          },
          {
            "match": "^FRAM GET/OK: 1/0$",
            "count": 1,
            "after_ms": 20000
          },
          {
            "match": "^ETH: OK \\| IP: 192\\.168\\.250\\.10 \\| RTC: 2026-03-15 10:30:\\d\\d \\| FRAM: GUARDADO OK \\| HTTP: FALLO CONNECT/DNS \\| GET OK: 0/1 \\| ERR: HTTP$",
            "count": 1,
            "after_ms": 20000
          }
        ],
        "console_absent": [
          "creando bloque",
          "HORA INVALIDA",
          "ERROR al guardar",
          "Ethernet no esta listo"
        ]
      }
    }
  ]
}
