{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "printStatus() cada 3 s en tres arranques. (1) Sin servidor DHCP: a los 3 s Link OFF (estado 3, LNK) y a los 9 s DHCP pending (estado 4, DHC, último error OK). (2) El servidor DHCP guionado responde OFFER y ACK (xid 0x394, el que genera el firmware con la semilla por defecto; MAC 02:4A:57:C4:0A:24) con 192.168.250.10/24, puerta de enlace y DNS 192.168.250.1. A los 9 s: Ready yes, OK, IP/gateway/máscara/DNS de la oferta, estado 5. (3) Sin W5500 (--no-eth): No Ethernet hardware (estado 6, HW).",
  "sketch": "package:libraries/JWPLC_Ethernet/examples/03.Ethernet_Diagnostics",
  "runs": [
    {
      "until_ms": 10000,
      "expect": {
        "console": [
          "^JWPLC Basic - Ethernet diagnostics$",
          {
            "match": "^--- ETH STATUS ---$",
            "count": 3
          },
          {
            "match": "^Ethernet enabled: yes$",
            "count": 3
          },
          {
            "match": "^Begin attempted: yes$",
            "count": 3
          },
          {
            "match": "^MAC: (?:[0-9A-F]{2}:){5}[0-9A-F]{2}$",
            "count": 3
          },
          {
            "match": "^Status: Link OFF$",
            "count": 1,
            "before_ms": 4000
          },
          {
            "match": "^Runtime state: 3$",
            "count": 1,
            "before_ms": 4000
          },
          {
            "match": "^Last error: Link OFF$",
            "count": 1,
            "before_ms": 4000
          },
          {
            "match": "^Status: DHCP pending$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Runtime state: 4$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Diagnostic code: DHC$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Last error: OK$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^IP: 0\\.0\\.0\\.0$",
            "count": 3
          }
        ],
        "console_absent": [
          "^Ready: yes$"
        ]
      }
    },
    {
      "until_ms": 10000,
      "stim": [
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 "
      ],
      "expect": {
        "console": [
          {
            "match": "^Ready: yes$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Status: OK$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^IP: 192\\.168\\.250\\.10$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Gateway: 192\\.168\\.250\\.1$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Subnet: 255\\.255\\.255\\.0$",
            "min": 1,
            "after_ms": 8000
          },
          {
            "match": "^DNS: 192\\.168\\.250\\.1$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Runtime state: 5$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Diagnostic code: ---$",
            "count": 1,
            "after_ms": 8000
          },
          {
            "match": "^Last error: OK$",
            "min": 1,
            "after_ms": 8000
          }
        ]
      }
    },
    {
      "until_ms": 4000,
      "args": [
        "--no-eth"
      ],
      "expect": {
        "console": [
          {
            "match": "^Status: No Ethernet hardware$",
            "count": 1
          },
          {
            "match": "^Diagnostic: HW$",
            "count": 1
          },
          {
            "match": "^Runtime state: 6$",
            "count": 1
          },
          {
            "match": "^Last error: No Ethernet hardware$",
            "count": 1
          }
        ],
        "console_absent": [
          "^Ready: yes$"
        ]
      }
    }
  ]
}
