{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "HTTPS por cable en JWPLC Sim: el cifrado lo hace la PC (servicio TLS del puente en 192.168.250.1:4430). DHCP guionado (el de 01.Ethernet_DHCP_Basic). (1) A los 10 s el sketch abre el socket 0 al servicio TLS; el guion responde OK y una respuesta HTTP 200: se imprime «Respuesta por Ethernet: HTTP/1.1 200 OK». (2) El servicio responde ERR CERT (certificado no válido): el sketch lo informa y no lee nada.",
  "sketch": "package:libraries/JWPLC_TLS/examples/01.TLS_HTTPS_Cable",
  "runs": [
    {
      "until_ms": 12500,
      "stim": [
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 ",
        "10100 net 0 connected 192.168.250.1:4430",
        "10300 net 0 data 4f4b0a",
        "10600 net 0 data 485454502f312e3120323030204f4b0d0a436f6e74656e742d4c656e6774683a20320d0a0d0a6f6b"
      ],
      "expect": {
        "console": [
          {
            "match": "^Respuesta por Ethernet: HTTP/1\\.1 200 OK$",
            "min": 1
          },
          {
            "match": "^Red: modo Ethernet \\| sale por: Ethernet \\| IP: 192\\.168\\.250\\.10 \\| cable: listo \\| WiFi: no incluida$",
            "min": 1
          }
        ]
      }
    },
    {
      "until_ms": 12500,
      "stim": [
        "6300 net 0 udp 192.168.250.1:67 ",
        "7400 net 0 udp 192.168.250.1:67 ",
        "10100 net 0 connected 192.168.250.1:4430",
        "10300 net 0 data 455252204345525420554e41424c455f544f5f5645524946595f4c4541465f5349474e41545552450a"
      ],
      "expect": {
        "console": [
          {
            "match": "^No se pudo conectar por HTTPS: CERTIFICADO NO VALIDO$",
            "min": 1
          }
        ],
        "console_absent": [
          "Respuesta por"
        ]
      }
    }
  ]
}