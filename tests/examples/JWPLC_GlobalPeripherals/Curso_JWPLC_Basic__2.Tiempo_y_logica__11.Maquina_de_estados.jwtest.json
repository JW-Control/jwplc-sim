      { "match": "^Estado: ROJO$", "count": 1, "after_ms": 13600, "before_ms": 13800 },
      { "match": "^Estado: VERDE$", "count": 1, "after_ms": 21600, "before_ms": 21800 },
      { "match": "^Estado: AMARILLO$", "count": 1, "after_ms": 51600, "before_ms": 51800 },
      { "match": "^Estado: ", "count": 5 }
    ],
    "signals": [
      { "at_ms": 10000, "DO": "0b00000100" },
      { "at_ms": 12000, "DO": "0b00000010" },
