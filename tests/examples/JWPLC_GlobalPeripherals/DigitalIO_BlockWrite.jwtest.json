{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Sin estímulos: tras el arranque las salidas recorren 0b10001000 (Q0_3, Q0_7) -> 0b00010001 (Q0_0, Q0_4) -> 0x00 cada segundo y el ciclo se repite.",
  "sketch": "package:libraries/JWPLC_GlobalPeripherals/examples/DigitalIO_BlockWrite",
  "until_ms": 6500,
  "expect": {
    "console": [
      { "match": "^JWPLC DigitalIO block write$", "count": 1 }
    ],
    "signals": [
      { "at_ms": 1900, "DO": "0b00000000" },
      { "at_ms": 2500, "DO": "0b10001000", "Q0_3": 1, "Q0_7": 1 },
      { "at_ms": 3500, "DO": "0b00010001", "Q0_0": 1, "Q0_4": 1 },
      { "at_ms": 4500, "DO": "0b00000000" },
      { "at_ms": 5500, "DO": "0b10001000" },
      { "at_ms": 6400, "DO": "0b00010001" }
    ]
  }
}
