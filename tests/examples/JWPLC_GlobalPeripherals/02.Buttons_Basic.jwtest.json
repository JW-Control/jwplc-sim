{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Una pulsación durante el arranque se descarta (clearPendingInput); luego cada botón da un PRESS y un RELEASE; mantener UP ~900 ms repite 'UP sigue presionado' cada 250 ms (isDown).",
  "sketch": "package:libraries/JWPLC_GlobalPeripherals/examples/02.Buttons_Basic",
  "until_ms": 5000,
  "stim": [
    "780 BTN_DOWN=1", "880 BTN_DOWN=0",
    "1380 BTN_OK=1", "1480 BTN_OK=0",
    "1780 BTN_LEFT=1", "1880 BTN_LEFT=0",
    "2180 BTN_UP=1", "3080 BTN_UP=0",
    "3380 BTN_ESC=1", "3480 BTN_ESC=0",
    "3680 BTN_DOWN=1", "3780 BTN_DOWN=0",
    "3980 BTN_RIGHT=1", "4080 BTN_RIGHT=0"
  ],
  "expect": {
    "console": [
      "^JWPLC Basic - Buttons$",
      { "match": "^PRESS   OK$", "count": 1, "after_ms": 1380, "before_ms": 1480 },
      { "match": "^RELEASE OK$", "count": 1, "after_ms": 1480, "before_ms": 1780 },
      { "match": "^PRESS   LEFT$", "count": 1, "after_ms": 1780, "before_ms": 1880 },
      { "match": "^RELEASE LEFT$", "count": 1, "after_ms": 1880, "before_ms": 2180 },
      { "match": "^PRESS   UP$", "count": 1, "after_ms": 2180, "before_ms": 2380 },
      { "match": "^UP sigue presionado$", "min": 3, "max": 4, "after_ms": 2180, "before_ms": 3080 },
      { "match": "^UP sigue presionado$", "count": 0, "after_ms": 3180 },
      { "match": "^RELEASE UP$", "count": 1, "after_ms": 3080, "before_ms": 3380 },
      { "match": "^PRESS   ESC$", "count": 1, "after_ms": 3380, "before_ms": 3480 },
      { "match": "^RELEASE ESC$", "count": 1, "after_ms": 3480, "before_ms": 3680 },
      { "match": "^PRESS   DOWN$", "count": 1 },
      { "match": "^PRESS   DOWN$", "count": 1, "after_ms": 3680, "before_ms": 3780 },
      { "match": "^RELEASE DOWN$", "count": 1 },
      { "match": "^PRESS   RIGHT$", "count": 1, "after_ms": 3980, "before_ms": 4080 },
      { "match": "^RELEASE RIGHT$", "count": 1, "after_ms": 4080 },
      { "match": "^(PRESS  |RELEASE) ", "count": 12 }
    ]
  }
}
