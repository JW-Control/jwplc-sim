{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Tres arranques con la microSD compartida: cada uno agrega 'Arranque ms=...' a /taller.txt y lo relee (1 y luego 2 líneas); el tercero arranca sin tarjeta (SD_CARD=0) e informa 'No card' sin tocar el archivo.",
  "sketch": "package:libraries/JWPLC_GlobalPeripherals/examples/05.microSD_Basic",
  "runs": [
    {
      "until_ms": 2000,
      "expect": {
        "console": [
          "^JWPLC Basic - microSD$",
          "^Card present = 1$",
          "^Ready = 1$",
          "^Contenido de /taller\\.txt:$",
          { "match": "^Arranque ms=\\d+$", "count": 1 }
        ],
        "console_absent": ["^Open write failed", "^No se pudo abrir", "^SD status"]
      }
    },
    {
      "until_ms": 2000,
      "expect": {
        "console": [
          "^Ready = 1$",
          { "match": "^Arranque ms=\\d+$", "count": 2 }
        ]
      }
    },
    {
      "until_ms": 2000,
      "stim": ["0 SD_CARD=0"],
      "expect": {
        "console": [
          "^Card present = 0$",
          "^Ready = 0$",
          "^SD status: No card$"
        ],
        "console_absent": ["^Contenido de", "^Arranque ms="]
      }
    }
  ]
}
