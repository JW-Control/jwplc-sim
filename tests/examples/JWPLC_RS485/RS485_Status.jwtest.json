{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "begin() con valores por defecto (Serial2, RX16/TX17, 115200 8N1) informa OK y el estado; después una línea de estado por segundo.",
  "sketch": "package:libraries/JWPLC_RS485/examples/RS485_Status",
  "until_ms": 4500,
  "expect": {
    "console": [
      "^JWPLC RS485 status test$",
      { "match": "^RS485 begin OK$", "count": 1 },
      "^RX pin: 16$",
      "^TX pin: 17$",
      "^AutoDirection: yes$",
      { "match": "^RS485: OK \\| Baud: 115200 \\| Config: SERIAL_8N1$", "count": 3 }
    ],
    "console_absent": ["begin failed"]
  }
}
