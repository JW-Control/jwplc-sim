{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Autoprueba del codec binario (se ejecuta una vez en setup): serializa el programa Default de 6 bloques (136 bytes), lo reconstruye y detecta corrupción de payload/cabecera, imagen truncada, buffer pequeño y nombre largo. No inicializa E/S: con I0_0..I0_3 activas todas las Q0 siguen apagadas.",
  "sketch": "package:libraries/JWPLC_LogicRuntime/examples/JWPLC_LogicRuntime_Codec",
  "until_ms": 3000,
  "stim": ["1500 I0_0=1", "1500 I0_1=1", "1500 I0_2=1", "1500 I0_3=1"],
  "expect": {
    "console": [
      "^JWPLC Logic Runtime - PoC 3 codec binario$",
      "^\\[PASS\\] serializacion correcta$",
      "^\\[PASS\\] bloques conservados$",
      "^\\[PASS\\] corrupcion de payload detectada$",
      "^\\[PASS\\] corrupcion de cabecera detectada$",
      "^\\[PASS\\] imagen truncada detectada$",
      "^\\[PASS\\] nombre largo rechazado$",
      "^Imagen de 6 bloques: 136 bytes$",
      "^Imagen maxima inicial de 100 bloques: \\d+ \\/ \\d+ bytes por slot$",
      "^Resultado: \\d+ PASS, 0 FAIL$",
      { "match": "^CODEC BINARIO: PASS$", "count": 1 }
    ],
    "console_absent": ["^\\[FAIL\\]", "^PRUEBA ABORTADA", "^FAIL:", "FALLO DE RUNTIME"],
    "signals": [{ "at_ms": 2900, "DI": "0b00001111", "DO": "0b00000000" }]
  }
}
