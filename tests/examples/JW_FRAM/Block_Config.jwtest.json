{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Escribe un bloque validado (magic, versión y CRC) en la FRAM del JWPLC Basic (CS en el GPIO13, JWPLC_FRAM_CS) y lo vuelve a leer: nombre de la máquina y contador de arranques. Hasta alpha.13 el ejemplo usaba el CS del W5500 (GPIO5) y la lectura fallaba (hallazgo H18, corregido en alpha.14).",
  "sketch": "package:libraries/JW_FRAM/examples/Block_Config",
  "until_ms": 1500,
  "expect": {
    "console": [
      "^JW_FRAM::begin\\(\\) usando tamano de FRAM forzado$",
      "^Size bytes: 8192$",
      {
        "match": "^Bloque validado escrito correctamente$",
        "count": 1
      },
      {
        "match": "^Bloque validado leido correctamente$",
        "count": 1
      },
      {
        "match": "^Machine: JWPLC Coffee & Milk$",
        "count": 1
      },
      {
        "match": "^Starts: 42$",
        "count": 1
      }
    ],
    "console_absent": [
      "^Fallo al inicializar la FRAM",
      "magic invalido",
      "^Bloque invalido"
    ]
  }
}
