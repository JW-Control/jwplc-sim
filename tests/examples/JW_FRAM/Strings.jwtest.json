{
  "$schema": "../../../schema/jwsim-test-1.json",
  "$comment": "Guarda un String y una cadena C en la FRAM (CS en el GPIO13) y los vuelve a leer. Hasta alpha.13 el ejemplo usaba el CS del W5500 (GPIO5) y leía textos vacíos (hallazgo H18, corregido en alpha.14).",
  "sketch": "package:libraries/JW_FRAM/examples/Strings",
  "until_ms": 1500,
  "expect": {
    "console": [
      "^JW_FRAM::begin\\(\\) usando tamano de FRAM forzado$",
      "^Size bytes: 8192$",
      {
        "match": "^String almacenado correctamente$",
        "count": 1
      },
      {
        "match": "^readString\\(\\): JWPLC Basic$",
        "count": 1
      },
      {
        "match": "^CString almacenado correctamente$",
        "count": 1
      },
      {
        "match": "^readCString\\(\\): JW Control$",
        "count": 1
      }
    ],
    "console_absent": [
      "^Fallo al inicializar la FRAM"
    ]
  }
}
