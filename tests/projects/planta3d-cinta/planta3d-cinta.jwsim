{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Planta 3D: cinta con física (piloto)",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/cinta_enclavada/cinta_enclavada.ino"
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1,
    "ioBridge": {
      "present": false
    }
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 0,
        "params": {
          "model": "MDR-60"
        }
      },
      {
        "id": "B1",
        "type": "jwsim/sensor-photoelectric",
        "x": 760,
        "y": 0,
        "params": {
          "source": "C1.sensorA"
        }
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "x": 920,
        "y": 0,
        "params": {
          "label": "Marcha",
          "color": "verde"
        }
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 1800,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "x": 2040,
        "y": 0,
        "params": {
          "color": "amarillo",
          "label": "Caja"
        }
      },
      {
        "id": "L1",
        "type": "jwsim/power-230vac",
        "x": 0,
        "y": 440
      },
      {
        "id": "M1",
        "type": "jwsim/motor",
        "x": 1800,
        "y": 420,
        "params": {
          "accelMs": 500,
          "stopMs": 500
        }
      },
      {
        "id": "C1",
        "type": "jwsim/conveyor-physics",
        "x": 760,
        "y": 440,
        "params": {
          "motor": "M1.speed",
          "largo": 4,
          "velocidad": 2,
          "pieza": 0.3,
          "masa": 2,
          "friccion": 0.5,
          "sensorA": 2.5,
          "sensorB": 3.5,
          "iniciales": 1
        }
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V2",
        "to": "B1.BN"
      },
      {
        "from": "B1.BU",
        "to": "PS1.-V2"
      },
      {
        "from": "B1.BK",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_1"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2"
      },
      {
        "from": "L1.L",
        "to": "KM1.1"
      },
      {
        "from": "KM1.2",
        "to": "M1.U1"
      },
      {
        "from": "M1.U2",
        "to": "L1.N"
      }
    ]
  }
}
