{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Planta 3D: cinta, tanque, puerta y cilindro",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.14"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/planta_3d/planta_3d.ino"
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
