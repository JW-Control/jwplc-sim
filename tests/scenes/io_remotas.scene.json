{
  "$comment": "Módulo de E/S remotas Modbus RTU (jwsim/remote-io, dirección 3, 9600 8N1) en el RS-485 de la placa. S1 da 24 V a DI1; H1 en DO1 y H8 en DO8 (común C1 y C2 al +24 V). El sketch io_remotas_modbus copia las entradas a las salidas.",
  "devices": [
    { "id": "plc", "type": "jwsim/jwplc-basic", "x": 0, "y": 0 },
    { "id": "PS1", "type": "jwsim/power-24vdc", "x": -300, "y": 0 },
    { "id": "IO1", "type": "jwsim/remote-io", "params": { "address": 3 }, "x": 600, "y": 0 },
    { "id": "S1", "type": "jwsim/selector-2", "x": 600, "y": 400 },
    { "id": "H1", "type": "jwsim/lamp", "x": 800, "y": 400 },
    { "id": "H8", "type": "jwsim/lamp", "params": { "color": "rojo" }, "x": 1000, "y": 400 }
  ],
  "wiring": [
    { "from": "PS1.+V1", "to": "plc.24VDC" }, { "from": "PS1.-V1", "to": "plc.M0" },
    { "from": "PS1.+V2", "to": "IO1.+" }, { "from": "IO1.-", "to": "PS1.-V2" },
    { "from": "plc.RS485_A", "to": "IO1.A" }, { "from": "plc.RS485_B", "to": "IO1.B" },
    { "from": "IO1.DC", "to": "PS1.-V2" },
    { "from": "PS1.+V1", "to": "S1.13" }, { "from": "S1.14", "to": "IO1.DI1" },
    { "from": "PS1.+V2", "to": "IO1.C1" }, { "from": "IO1.DO1", "to": "H1.X1" }, { "from": "H1.X2", "to": "PS1.-V1" },
    { "from": "PS1.+V2", "to": "IO1.C2" }, { "from": "IO1.DO8", "to": "H8.X1" }, { "from": "H8.X2", "to": "PS1.-V1" }
  ]
}
