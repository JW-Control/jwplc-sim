      "params": {
        "label": "Marcha"
      },
      "x": 300,
      "y": -320
    },
    {
      "id": "S0",
      "type": "jwsim/pushbutton-nc",
      "params": {
        "label": "Parada"
      },
      "x": 480,
      "y": -320
