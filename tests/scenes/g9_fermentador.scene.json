{
  "$comment": "Fermentador de café emulado (G9) como bloque de planta: Y1, M1, M2, FS1 y las sondas vienen en FER1; aquí solo va el tablero y su cableado. Q0_0 electroválvula Y1 (24 VDC), Q0_1 bomba de retorno M1 y Q0_2 bomba de mosto M2 (230 VAC por los relés de la placa), Q0_3 sirena, Q0_4 baliza. I0_0 flujostato FS1. RS-485 9600 8N1: TT1 (dir. 1) lee la PT100 de masa y AT1 (dir. 2) el electrodo de pH y la temperatura de mosto, por cable. Parámetros del proceso acelerados para pruebas.",
  "devices": [
    { "id": "plc", "type": "jwsim/jwplc-basic", "x": 300, "y": 0 },
    { "id": "PS1", "type": "jwsim/power-24vdc", "x": 40, "y": 60 },
    { "id": "L1", "type": "jwsim/power-230vac", "x": 40, "y": 640 },
    { "id": "TT1", "type": "jwsim/pt100-rs485", "params": { "address": 1 }, "x": 860, "y": 40 },
    { "id": "AT1", "type": "jwsim/ph-rs485", "params": { "address": 2 }, "x": 1100, "y": 40 },
    { "id": "HA1", "type": "jwsim/buzzer", "x": 860, "y": 300 },
    { "id": "H1", "type": "jwsim/lamp", "params": { "color": "rojo", "label": "Fin" }, "x": 1060, "y": 300 },
    { "id": "FER1", "type": "jwsim/fermentador", "params": { "terma": "fija", "tTerma": 80, "tInicial": 24, "tAmbiente": 22, "kCalef": 0.02, "horasFermentacion": 0.5 }, "x": 300, "y": 640 }
  ],
  "wiring": [
    { "from": "PS1.+V1", "to": "plc.24VDC" }, { "from": "PS1.-V1", "to": "plc.M0" }, { "from": "PS1.-V1", "to": "plc.M1" },
    { "from": "PS1.+V2", "to": "TT1.+" }, { "from": "TT1.-", "to": "PS1.-V2" },
    { "from": "PS1.+V2", "to": "AT1.+" }, { "from": "AT1.-", "to": "PS1.-V2" },
    { "from": "plc.RS485_A", "to": "TT1.A" }, { "from": "plc.RS485_B", "to": "TT1.B" },
    { "from": "TT1.A", "to": "AT1.A" }, { "from": "TT1.B", "to": "AT1.B" },
    { "from": "FER1.TT_R1", "to": "TT1.R1" }, { "from": "FER1.TT_R2", "to": "TT1.R2" }, { "from": "FER1.TT_R3", "to": "TT1.R3" },
    { "from": "FER1.AT_PH", "to": "AT1.PH" }, { "from": "FER1.AT_REF", "to": "AT1.REF" },
    { "from": "FER1.AT_T1", "to": "AT1.T1" }, { "from": "FER1.AT_T2", "to": "AT1.T2" },
    { "from": "PS1.+V1", "to": "FER1.FS_C" }, { "from": "FER1.FS_NO", "to": "plc.I0_0" },
    { "from": "PS1.+V1", "to": "plc.Q0_0.1" }, { "from": "plc.Q0_0.2", "to": "FER1.Y1_A1" }, { "from": "FER1.Y1_A2", "to": "PS1.-V2" },
    { "from": "L1.L", "to": "plc.Q0_1.1" }, { "from": "plc.Q0_1.2", "to": "FER1.M1_U1" }, { "from": "FER1.M1_U2", "to": "L1.N" },
    { "from": "L1.L", "to": "plc.Q0_2.1" }, { "from": "plc.Q0_2.2", "to": "FER1.M2_U1" }, { "from": "FER1.M2_U2", "to": "L1.N" },
    { "from": "PS1.+V1", "to": "plc.Q0_3.1" }, { "from": "plc.Q0_3.2", "to": "HA1.+" }, { "from": "HA1.-", "to": "PS1.-V2" },
    { "from": "PS1.+V1", "to": "plc.Q0_4.1" }, { "from": "plc.Q0_4.2", "to": "H1.X1" }, { "from": "H1.X2", "to": "PS1.-V2" }
  ]
