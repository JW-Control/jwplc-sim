{
  "$schema": "../../schema/jwsim-test-1.json",
  "$comment": "Gate G7 (co-simulación, falla eléctrica): la bobina de KM1 tiene A2 sin cablear. La escena avisa 'bobina sin alimentación', KM1 nunca confirma y el firmware entra en falla a los 100 ms: el piloto H1 (Q0_2) se enciende.",
  "sketch": "../sketches/g7_cosim",
  "scene": {
    "devices": [
      { "id": "plc", "type": "jwsim/jwplc-basic" },
      { "id": "PS1", "type": "jwsim/power-24vdc" },
      { "id": "S1", "type": "jwsim/pushbutton-no" },
      { "id": "S0", "type": "jwsim/pushbutton-nc" },
      { "id": "KM1", "type": "jwsim/contactor" },
      { "id": "H1", "type": "jwsim/lamp", "params": { "color": "rojo" } }
    ],
    "wiring": [
      { "from": "PS1.+V1", "to": "plc.24VDC" }, { "from": "PS1.-V1", "to": "plc.M0" }, { "from": "PS1.-V1", "to": "plc.M1" },
      { "from": "PS1.+V1", "to": "S1.13" }, { "from": "S1.14", "to": "plc.I0_0" },
      { "from": "PS1.+V1", "to": "S0.11" }, { "from": "S0.12", "to": "plc.I0_1" },
      { "from": "PS1.+V1", "to": "KM1.13" }, { "from": "KM1.14", "to": "plc.I0_2" },
      { "from": "PS1.+V1", "to": "plc.Q0_0.1" }, { "from": "plc.Q0_0.2", "to": "KM1.A1" },
      { "from": "PS1.+V1", "to": "plc.Q0_2.1" }, { "from": "plc.Q0_2.2", "to": "H1.X1" }, { "from": "H1.X2", "to": "PS1.-V1" }
    ]
  },
  "until_ms": 1500,
  "actions": [
    { "at_ms": 1000, "device": "S1", "action": "press", "value": true },
    { "at_ms": 1050, "device": "S1", "action": "press", "value": false }
  ],
  "expect": {
    "console": ["ms marcha", "FALLA KM1 sin confirmacion"],
    "signals": [{ "at_ms": 1400, "Q0_0": 0, "Q0_2": 1 }],
    "scene": {
      "state": [{ "at_ms": 1400, "KM1.closed": false, "H1.lit": true }],
      "faults": [],
      "findings": ["KM1.coil"]
    }
  }
}
