{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Fermentador de café (emulación de planta)",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "../sketches/g9_fermentador_basico/g9_fermentador_basico.ino"
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 0
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 300,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 40,
        "y": 60
      },
      {
        "id": "L1",
        "type": "jwsim/power-230vac",
        "x": 40,
        "y": 1020
      },
      {
        "id": "FER1",
        "type": "jwsim/fermentador",
        "params": {
          "terma": "fija",
          "tTerma": 80,
          "tInicial": 24,
          "tAmbiente": 22,
          "kCalef": 0.02,
          "horasFermentacion": 0.5
        },
        "x": 900,
        "y": 560
      },
      {
        "id": "TT1",
        "type": "jwsim/pt100-rs485",
        "params": {
          "address": 1,
          "source": "FER1.tMasa"
        },
        "x": 900,
        "y": 40
      },
      {
        "id": "AT1",
        "type": "jwsim/ph-rs485",
        "params": {
          "address": 2,
          "sourcePh": "FER1.ph",
          "sourceTemp": "FER1.tMosto"
        },
        "x": 900,
        "y": 260
      },
      {
        "id": "Y1",
        "type": "jwsim/water-valve",
        "x": 240,
        "y": 620
      },
      {
        "id": "M1",
        "type": "jwsim/motor",
        "params": {
          "accelMs": 200,
          "stopMs": 300
        },
        "x": 280,
        "y": 1040
      },
      {
        "id": "M2",
        "type": "jwsim/motor",
        "params": {
          "accelMs": 200,
          "stopMs": 300
        },
        "x": 540,
        "y": 1040
      },
      {
        "id": "HA1",
        "type": "jwsim/buzzer",
        "x": 460,
        "y": 620
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Fin"
        },
        "x": 660,
        "y": 620
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V2",
        "to": "TT1.+"
      },
      {
        "from": "TT1.-",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V2",
        "to": "AT1.+"
      },
      {
        "from": "AT1.-",
        "to": "PS1.-V2"
      },
      {
        "from": "plc.RS485_A",
        "to": "TT1.A"
      },
      {
        "from": "plc.RS485_B",
        "to": "TT1.B"
      },
      {
        "from": "TT1.A",
        "to": "AT1.A"
      },
      {
        "from": "TT1.B",
        "to": "AT1.B"
      },
      {
        "from": "PS1.+V1",
        "to": "FER1.FS1"
      },
      {
        "from": "FER1.FS2",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "Y1.A1"
      },
      {
        "from": "Y1.A2",
        "to": "PS1.-V2"
      },
      {
        "from": "L1.L",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "M1.U1"
      },
      {
        "from": "M1.U2",
        "to": "L1.N"
      },
      {
        "from": "L1.L",
        "to": "plc.Q0_2.1"
      },
      {
        "from": "plc.Q0_2.2",
        "to": "M2.U1"
      },
      {
        "from": "M2.U2",
        "to": "L1.N"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_3.1"
      },
      {
        "from": "plc.Q0_3.2",
        "to": "HA1.+"
      },
      {
        "from": "HA1.-",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_4.1"
      },
      {
        "from": "plc.Q0_4.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2"
      }
    ]
  }
}