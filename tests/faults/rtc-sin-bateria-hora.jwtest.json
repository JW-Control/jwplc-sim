{
  "$schema": "../../schema/jwsim-test-1.json",
  "$comment": "Falla G9 rtc-battery: la hora fijada en el primer arranque se conserva con batería (Valid: 1); con la batería agotada el RTC arranca sin hora válida (Valid: 0, OSF = 1).",
  "sketch": "package:libraries/JW_RTC/examples/BasicRead",
  "runs": [
    { "until_ms": 1500, "args": ["--rtc", "fijo:2026-01-15T08:30:00"], "expect": { "console": ["^Valid: 1 \\| 2026/01/15 08:30:01$"] } },
    { "until_ms": 1500, "expect": { "console": ["^Valid: 1 \\| 2026/01/15 08:30:0\\d$"], "console_absent": ["^Valid: 0"] } },
    { "until_ms": 1500, "faults": [{ "kind": "rtc-battery" }], "expect": { "console": ["^Valid: 0 \\| "], "console_absent": ["^Valid: 1"] } }
  ]
}
