1800 I0_1=0
2000 I0_0=1
2003 I0_0=0        # pulso de 3 ms < periodo de escaneo de 20 ms: puede perderse
2500 I0_0=1
2550 I0_7=1
3000 I0_0=0
3200 I0_7=0
