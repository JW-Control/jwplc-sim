# Patrones de 8 bits en I0_0..I0_7 (bit k = I0_k), uno cada 600 ms desde 2000 ms.
# Usado por el gate JWSIM_G1_PACKAGE_EXAMPLES_IO.
# 2000 ms -> 0x01
2000 I0_0=1
# 2600 ms -> 0x02
2600 I0_0=0
2600 I0_1=1
# 3200 ms -> 0x04
3200 I0_1=0
3200 I0_2=1
# 3800 ms -> 0x08
3800 I0_2=0
3800 I0_3=1
# 4400 ms -> 0x10
4400 I0_3=0
4400 I0_4=1
# 5000 ms -> 0x20
5000 I0_4=0
5000 I0_5=1
# 5600 ms -> 0x40
5600 I0_5=0
5600 I0_6=1
# 6200 ms -> 0x80
6200 I0_6=0
6200 I0_7=1
# 6800 ms -> 0xFF
6800 I0_0=1
6800 I0_1=1
6800 I0_2=1
6800 I0_3=1
6800 I0_4=1
6800 I0_5=1
6800 I0_6=1
# 7400 ms -> 0xA5
7400 I0_1=0
7400 I0_3=0
7400 I0_4=0
7400 I0_6=0
# 8000 ms -> 0x5A
8000 I0_0=0
8000 I0_1=1
8000 I0_2=0
8000 I0_3=1
8000 I0_4=1
8000 I0_5=0
8000 I0_6=1
8000 I0_7=0
# 8600 ms -> 0x00
8600 I0_1=0
8600 I0_3=0
8600 I0_4=0
8600 I0_6=0
