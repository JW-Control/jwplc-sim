    H1 AT %QX0.1  : BOOL; (* mantenimiento *)
    T_SEG         : TON;
    PULSO         : BOOL; (* TRUE una vuelta por segundo de marcha *)
    SEGUNDOS      : INT; (* horómetro: segundos de marcha *)
    HAY_TIEMPO    : BOOL; (* SEGUNDOS < 20 *)
  END_VAR

