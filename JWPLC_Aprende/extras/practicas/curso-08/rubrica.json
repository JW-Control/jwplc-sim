{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-08",
  "goals": [
    {
      "id": "lampara",
      "description": "H2 (Q0.2) encendida con el motor en marcha",
      "when": {
        "Q0_0": 1,
        "Q0_2": 1
      },
      "hold_ms": 500,
      "hint": "digitalWrite(Q0_2, motor);"
    },
    {
      "id": "lampara_off",
      "description": "H2 se apaga al detener el motor",
      "when": {
        "Q0_0": 0,
        "Q0_2": 0
      },
      "hold_ms": 300,
      "after": "lampara"
    },
    {
      "id": "disparo",
      "description": "Dispara el térmico (aprieta F1): el motor se detiene",
      "when": {
        "I0_2": 0,
        "Q0_0": 0
      },
      "hold_ms": 300,
      "after": "lampara_off"
    },
    {
      "id": "bloqueo",
      "description": "Con el térmico ya normal, MARCHA no arranca sin reconocer la falla",
      "when": {
        "I0_2": 1,
        "I0_0": 1,
        "Q0_0": 0
      },
      "hold_ms": 500,
      "after": "disparo",
      "hint": "Una variable falla que se pone en true cuando el térmico abre y vuelve a false solo con PARADA; el motor pide !falla."
    },
    {
      "id": "reconoce",
      "description": "Tras apretar PARADA, MARCHA arranca de nuevo",
      "when": {
        "Q0_0": 1
      },
      "hold_ms": 500,
      "after": "bloqueo",
      "why": "La falla queda memorizada: alguien tiene que verla y reconocerla antes de volver a arrancar."
    }
  ],
