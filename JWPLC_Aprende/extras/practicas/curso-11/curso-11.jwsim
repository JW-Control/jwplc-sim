  "exercise": {
    "lesson": "curso-11",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Maquina_de_estados",
    "brief": {
      "goal": "Verde peatonal que parpadea en sus últimos 3 s y modo noche con amarillo intermitente.",
      "steps": [
        "Ejecuta el ejemplo y aprieta el botón del peatón (S1).",
        "En ROJO, haz parpadear el verde peatonal (Q0.3) cada medio segundo en los últimos 3 s.",
        "Con SA1 (I0.1) activo: modo noche, solo el amarillo parpadea cada medio segundo."
      ],
      "uses": [
        "I0_0 · S1, botón del peatón",
        "I0_1 · SA1, modo noche",
        "Q0_0 · H1, rojo",
        "Q0_1 · H2, amarillo",
        "Q0_2 · H3, verde",
        "Q0_3 · H4, verde peatonal"
      ],
      "teaches": "Cada estado decide sus salidas con su propio tiempo; un modo especial se resuelve antes que la máquina de estados."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
