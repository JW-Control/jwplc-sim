{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-15",
  "goals": [
    {
      "id": "man",
      "description": "En MAN (H1), el impulso S1 mueve el motor",
      "when": {
        "Q0_1": 1,
        "I0_2": 1,
        "Q0_0": 1
      },
      "hold_ms": 300
    },
    {
      "id": "parpadea",
      "description": "En AUT, con el ciclo en curso, H2 (Q0.2) parpadea cada medio segundo",
      "period": "Q0_2",
      "on_ms": [
        450,
        550
      ],
      "off_ms": [
        450,
        550
      ],
      "cycles": 3,
      "hint": "bool parpadeo = (millis() / 500) % 2 == 0; y H2 = modo == AUTOMATICO && (sin ciclo || parpadeo)."
    },
    {
      "id": "descarga",
      "description": "Al terminar la mezcla, el motor para y Y1 (Q0.3) descarga",
      "when": {
        "Q0_0": 0,
        "Q0_3": 1
      },
      "hold_ms": 1000,
      "hint": "Cambia bool ciclo por un enum Paso { REPOSO, MEZCLANDO, DESCARGANDO }, con un TON para cada paso con tiempo."
    },
    {
      "id": "reposo",
      "description": "A los 3 s la válvula cierra y H2 queda fija",
      "when": {
        "I0_1": 1,
        "Q0_0": 0,
        "Q0_3": 0,
        "Q0_2": 1
      },
      "hold_ms": 1500,
      "after": "descarga"
    },
    {
      "id": "cero",
      "description": "Arranca otro ciclo y pasa SA1 a 0: todo se detiene",
      "when": {
        "I0_0": 0,
        "I0_1": 0,
        "Q0_0": 0,
        "Q0_2": 0,
        "Q0_3": 0
      },
      "hold_ms": 500,
      "after": "reposo",
      "why": "Cambiar de modo vuelve el ciclo a REPOSO: la máquina nunca sigue sola en un modo que el operador ya dejó."
    }
  ],
