{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 40 · Un transmisor de presión",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Leer_un_transmisor/Leer_un_transmisor.ino"
  },
  "exercise": {
    "lesson": "curso-40",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Leer_un_transmisor",
    "brief": {
      "goal": "Alarma de presión baja con histéresis: bajo 2,0 bar avisa y enciende H2; solo se normaliza sobre 2,5 bar.",
      "steps": [
        "Ejecuta el ejemplo y mueve la presión de PT1 en su símbolo: la consola la muestra en bar.",
        "Bajo 2,0 bar: «Presión baja» una vez y H2 (Q0.1) encendida.",
        "Sobre 2,5 bar: «Presión normal» y H2 apagada. Entre 2,0 y 2,5 bar no cambia nada: es la histéresis."
      ],
      "uses": [
        "RS-485 · PT1, transmisor 0-10 bar, dirección 1",
        "Registro input 0 · presión × 100",
        "Q0_0 · H1, falla del sensor",
        "Q0_1 · H2, presión baja"
      ],
      "teaches": "Una medida analógica llega como número: se escala a la unidad de la máquina, se valida y recién se decide. Una alarma con histéresis no titila alrededor del límite."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 380
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 380
      },
      {
        "id": "PT1",
        "type": "jwsim/pressure-rs485",
        "params": {
          "address": 1
        },
        "x": 420,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Falla sensor"
        },
        "x": 280,
        "y": 1080
      },
      {
        "id": "H2",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Presión baja"
        },
        "x": 480,
        "y": 1080
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V2",
        "to": "PT1.+",
        "ref": true
      },
      {
        "from": "PT1.-",
        "to": "PS1.-V2",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H2.X1"
      },
      {
        "from": "H2.X2",
        "to": "PS1.-V2",
        "ref": true
      },
      {
        "from": "plc.RS485_A",
        "to": "PT1.A"
      },
      {
        "from": "plc.RS485_B",
        "to": "PT1.B"
      }
    ]
  }
}
