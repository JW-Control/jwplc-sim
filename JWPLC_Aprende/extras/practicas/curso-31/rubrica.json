  "id": "curso-31",
  "goals": [
    {
      "id": "ritmo",
      "description": "Cinta en marcha: «Ritmo: N piezas/min» cada 5 s",
      "console": "Ritmo:",
      "hint": "Arranca con S1 y da toques a B1 en Mandos; mira la curva en la pestaña Placa."
    },
    {
      "id": "bajo",
      "description": "Ritmo bajo con la ventana llena: «Ritmo bajo: N piezas/min»",
      "console": "Ritmo bajo",
      "hint": "En el bloque de cada 5 s, si pasaron 30 s desde la marcha y ritmo < 12, avisa una vez (un bool ritmoBajo) y enciende Q0_1.",
      "why": "Los primeros 30 s el ritmo todavía sube: juzgarlo antes daría falsas alarmas."
    },
    {
      "id": "normal",
      "description": "El ritmo se recupera: «Ritmo normal»",
      "console": "Ritmo normal",
      "after": "bajo"
    }
  ],
