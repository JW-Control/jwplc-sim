      },
      {
        "from": "B1.BU",
        "to": "PS1.-V1",
        "ref": true
      },
      {
        "from": "B1.BK",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "F1.11",
