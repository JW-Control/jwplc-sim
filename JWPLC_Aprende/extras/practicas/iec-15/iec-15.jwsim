{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 15 · Contar el tiempo: un horómetro con mantenimiento",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-15",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Aviso de mantenimiento H1 a los 10 s de marcha y, a los 20 s, el motor se detiene y no vuelve a arrancar.",
      "steps": [
        "Ejecuta el ejemplo: con S1 el motor marcha y SEGUNDOS sube uno por segundo (míralo en las variables en vivo).",
        "Adelanta el aviso H1 a los 10 s.",
        "Agrega el bloqueo: el motor marcha solo mientras SEGUNDOS < 20.",
        "Pasados los 20 s, S1 ya no lo arranca."
      ],
      "uses": [
        "%IX0.0 · S1, marcha",
        "%IX0.1 · S2, paro NC",
        "%QX0.0 · KM1, motor",
        "%QX0.1 · H1, mantenimiento"
      ],
      "teaches": "Un TON que se reinicia con su propia salida da un pulso por segundo; sumar esos pulsos convierte el tiempo en un número que se puede comparar, como un horómetro."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 380,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Paro"
        },
        "x": 580,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Mantenimiento"
        },
        "x": 560,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      }
    ]
  }
}
