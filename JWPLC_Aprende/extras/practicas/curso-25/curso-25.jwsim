{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 25 · Proyecto: un contador de lotes con todo el equipo",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Proyecto_contador_de_lotes/Proyecto_contador_de_lotes.ino"
  },
  "exercise": {
    "lesson": "curso-25",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Proyecto_contador_de_lotes",
    "brief": {
      "goal": "Que la cinta espere a que el operador reconozca cada lote y que a las 06:00:00 se registre el cambio de turno.",
      "steps": [
        "Ejecuta el ejemplo: el reloj arranca a las 05:59:30. Cuenta un lote de 6 piezas con B1.",
        "Al completar un lote, la cinta KM1 (Q0.1) se detiene y H1 (Q0.2) parpadea hasta que el operador aprieta OK.",
        "A las 06:00:00 escribe «Cambio de turno: N lotes», regístralo en la microSD y pon los lotes en 0."
      ],
      "uses": [
        "I0_0 · B1, sensor de piezas",
        "Q0_0 · Y1, empujador",
        "Q0_1 · KM1, cinta",
        "Q0_2 · H1, lote listo",
        "Botonera: UP, DOWN, OK, ESC"
      ],
      "teaches": "Un programa real junta botonera, buzzer, reloj, FRAM y microSD, cada uno con su trabajo."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1,
    "rtc": "fijo:2026-11-24T05:59:30"
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "B1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "negro",
          "label": "Pieza"
        },
        "x": 460,
        "y": 0
      },
      {
        "id": "Y1",
        "type": "jwsim/solenoid-valve",
        "x": 280,
        "y": 1060
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 840,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Lote listo"
        },
        "x": 1120,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "B1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "B1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "Y1.A1",
        "color": "negro"
      },
      {
        "from": "Y1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_2.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_2.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      }
    ]
  }
}
