{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-25",
  "goals": [
    {
      "id": "lote",
      "description": "Seis toques a B1: «Lote 1 completo (6 piezas)»",
      "console": "Lote \\d+ completo",
      "hint": "El lote es de 6 piezas; cambia el tamaño con UP y DOWN."
    },
    {
      "id": "espera",
      "description": "Con el lote listo, la cinta KM1 (Q0.1) se detiene y H1 (Q0.2) parpadea",
      "period": "Q0_2",
      "on_ms": [
        300,
        500
      ],
      "off_ms": [
        300,
        500
      ],
      "cycles": 2,
      "after": "lote",
      "hint": "Un bool esperandoOk = true; en loteCompleto(); la cinta es digitalWrite(Q0_1, !esperandoOk);"
    },
    {
      "id": "reconoce",
      "description": "OK: «Lote reconocido» y la cinta sigue",
      "console": "Lote reconocido",
      "after": "lote"
    },
    {
      "id": "turno",
      "description": "A las 06:00:00: «Cambio de turno: N lotes»",
      "console": "Cambio de turno: \\d+ lotes",
      "hint": "Pasa la hora a segundos del día (lección 21) y detecta el instante en que cruza las 06:00:00: el segundo anterior era menor y el actual es mayor o igual.",
      "why": "Comparar con el valor anterior detecta el momento justo, aunque el loop pase miles de veces por ese segundo."
    }
  ],
