{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-39",
  "goals": [
    {
      "id": "auto",
      "description": "Automático y 45 °C: el extractor a 30 Hz",
      "when": {
        "VF1.fRef": 30
