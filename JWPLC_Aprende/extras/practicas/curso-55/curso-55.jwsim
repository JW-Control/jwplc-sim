  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Recetas/Recetas.ino"
  },
  "exercise": {
    "lesson": "curso-55",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Recetas",
    "brief": {
      "goal": "La receta elegida sobrevive a un corte de luz: se guarda en la FRAM al elegirla y se recupera al encender.",
      "steps": [
        "Ejecuta el ejemplo: UP y DOWN eligen la receta y S1 corre su ciclo. Apaga la placa: vuelve a YOGUR.",
        "Al cambiar la receta, guarda su número en la FRAM con writeBlock (lección 22).",
        "Al encender, si readBlock lo encuentra y es válido (menor que CANTIDAD): «Receta recuperada: N NOMBRE»."
      ],
      "uses": [
        "I0_0 · S1, marcha (NA)",
        "Q0_0 · KM1, mezcla",
        "Q0_1 · H1, producto listo",
        "Botonera: UP, DOWN",
        "FRAM"
      ],
      "teaches": "Una receta es un juego de números para el mismo programa. Una tabla de structs las ordena y la FRAM recuerda cuál estaba en uso."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
