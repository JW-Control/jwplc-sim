  "id": "curso-32",
  "goals": [
    {
      "id": "lote",
      "description": "Completa un lote: «Lote completo: 10 piezas»",
      "console": "Lote completo",
      "hint": "S1 en Mandos y diez toques a B1."
    },
    {
      "id": "tiempo",
      "description": "«Lote N completo en mm:ss»",
      "console": "completo en",
      "hint": "Anota millis() cuando empieza un lote (lote == 0 al arrancar) y, al completarlo, imprime los segundos como mm:ss con %02lu."
    },
    {
      "id": "atasco",
      "description": "20 s sin piezas: «Alarma A01: atasco»",
      "console": "Alarma A01: atasco"
    },
    {
      "id": "bloqueo",
      "description": "Sin reconocer, MARCHA: «Reconozca la alarma A01»",
      "console": "Reconozca la alarma A01",
      "after": "atasco",
      "hint": "Si alarmaAbierta, MARCHA no arranca la cinta: avisa como mucho una vez por segundo.",
      "why": "La causa del atasco hay que verla antes de volver a arrancar."
    }
  ],
