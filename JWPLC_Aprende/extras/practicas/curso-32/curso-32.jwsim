{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 32 · Proyecto: la HMI de una cinta de lotes",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Proyecto_HMI_cinta_de_lotes/Proyecto_HMI_cinta_de_lotes.ino"
  },
  "exercise": {
    "lesson": "curso-32",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Proyecto_HMI_cinta_de_lotes",
    "brief": {
      "goal": "Que el operador vea cuánto tarda cada lote y que la cinta no arranque con un atasco sin reconocer.",
      "steps": [
        "Ejecuta el ejemplo: recorre las tres páginas con LEFT y RIGHT, cambia el lote en AJUSTES y completa uno con S1 y toques a B1.",
        "Al completar cada lote: «Lote N completo en mm:ss», con N contando desde el encendido.",
        "Con la ventana A01 abierta, MARCHA no arranca: «Reconozca la alarma A01», como mucho una vez por segundo."
      ],
      "uses": [
        "I0_0 · S1, MARCHA (NA)",
        "I0_1 · S0, PARADA (NC)",
        "I0_2 · B1, sensor de piezas",
        "Q0_0 · KM1, motor de la cinta",
        "Q0_1 · H1, falla",
        "Botonera: páginas, ajuste y reconocimiento",
        "Pantalla TFT: tres páginas y ventana de alarma"
      ],
      "teaches": "Una HMI completa junta estado, tendencia, ajustes y alarmas; cada pieza es una lección de la unidad."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "label": "Marcha",
          "color": "verde"
        },
        "x": 760,
        "y": 0
      },
      {
        "id": "S0",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "label": "Parada",
          "color": "rojo"
        },
        "x": 920,
        "y": 0
      },
      {
        "id": "B1",
        "type": "jwsim/sensor-inductive",
        "x": 1100,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 1800,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Falla"
        },
        "x": 2040,
        "y": 0
      },
      {
        "id": "L1",
        "type": "jwsim/power-230vac",
        "x": 0,
        "y": 440
      },
      {
        "id": "M1",
        "type": "jwsim/motor",
        "x": 1800,
        "y": 420
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "S0.11"
      },
      {
        "from": "S0.12",
        "to": "plc.I0_1"
      },
      {
        "from": "PS1.+V2",
        "to": "B1.BN"
      },
      {
        "from": "B1.BU",
        "to": "PS1.-V2"
      },
      {
        "from": "B1.BK",
        "to": "plc.I0_2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2"
      },
      {
        "from": "L1.L",
