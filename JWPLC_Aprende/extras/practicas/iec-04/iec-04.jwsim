{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 04 · Set y reset",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-04",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Falla del térmico memorizada en H1 (Q0.1): tras dispararse, MARCHA no arranca hasta reconocerla con PARADA.",
      "steps": [
        "Ejecuta el ejemplo: MARCHA pone KM1 y PARADA lo quita.",
        "Memoriza la falla: una variable FALLA que se pone con el térmico abierto.",
        "PARADA la reconoce (la borra) solo con el térmico ya rearmado.",
        "MARCHA solo arranca sin falla; H1 muestra la falla."
      ],
      "uses": [
        "%IX0.0 · S1, MARCHA (NA)",
        "%IX0.1 · S2, PARADA (NC)",
        "%IX0.2 · F1, térmico (NC)",
        "%QX0.0 · KM1, contactor",
        "%QX0.1 · H1, falla",
        "%QX0.2 · H2, marcha"
      ],
      "teaches": "Set y reset (bobinas S y R, bloques SR y RS) guardan un estado hasta que otra condición lo borra; el que se escribe al final gana."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 280,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Parada"
        },
        "x": 480,
        "y": 0
      },
      {
        "id": "F1",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "azul",
          "label": "Térmico 95-96"
        },
        "x": 680,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Falla"
        },
        "x": 560,
        "y": 1060
      },
      {
        "id": "H2",
