{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-50",
  "goals": [
    {
      "id": "marcha",
      "description": "S1 arranca un lote",
      "when": {
        "KM1.closed": true
      },
      "hold_ms": 500,
      "hint": "Mandos: S1."
    },
    {
      "id": "meta",
      "description": "«Meta cumplida: N cajas»",
      "console": "Meta cumplida: \\d+ cajas",
      "hint": "Baja la meta en el panel y pasa cajas por B1."
    },
    {
      "id": "cero",
      "description": "«Contador a cero desde el panel»",
      "console": "Contador a cero desde el panel",
      "hint": "if (reiniciar) { cajas = 0; reiniciar = false; }",
      "why": "Una orden por la red se cumple una vez: devolverla a falso es el acuse que ve el operador."
    }
  ],
  "cases": [
    {
      "name": "Lote de 3 cajas y contador a cero",
      "until_ms": 17000,
      "actions": [
        {
          "at_ms": 9000,
          "device": "WEB",
          "action": "write",
          "id": "meta",
          "value": 3
        },
