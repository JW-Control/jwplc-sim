{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-17",
  "goals": [
    {
      "id": "reporte",
      "description": "Arranca el motor: cada 5 s, «En marcha hh:mm:ss | total hh:mm:ss»",
      "console": "En marcha 00:00:05 \\| total",
      "hint": "Ya lo hace el ejemplo: déjalo en marcha 5 segundos."
    },
    {
      "id": "mant",
      "description": "A los 30 s de marcha total: «Mantenimiento: 00:00:30 de marcha»",
      "console": "Mantenimiento: 00:00:30 de marcha",
      "hint": "Un bool mantenimiento = false; y en loop(): if (!mantenimiento && marchaTotal() >= 30000) { mantenimiento = true; Serial.printf(...); }"
    },
    {
      "id": "h1",
      "description": "H1 (Q0.1) queda encendida desde el aviso",
      "when": {
        "Q0_1": 1
      },
      "hold_ms": 1000,
      "after": "mant"
    },
    {
      "id": "uso",
      "description": "Al parar, el uso con un decimal: «Uso: 92.3 %»",
      "console": "Uso: \\d{1,3}\\.\\d %",
      "hint": "float uso = marchaAnterior * 100.0 / millis(); y Serial.printf(\"Uso: %.1f %%\\n\", uso); (%% escribe un signo %).",
      "why": "printf arma el texto entero con su formato: cifras, ceros a la izquierda y decimales, en una sola línea."
    }
  ],
