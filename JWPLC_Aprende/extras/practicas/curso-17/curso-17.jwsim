{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 17 · Mensajes para el operador: un horómetro",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Mensajes_para_el_operador/Mensajes_para_el_operador.ino"
  },
  "exercise": {
    "lesson": "curso-17",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Mensajes_para_el_operador",
    "brief": {
      "goal": "Un aviso de mantenimiento a los 30 s de marcha total y el porcentaje de uso en cada parada.",
      "steps": [
        "Ejecuta el ejemplo: arranca y para el motor y mira los mensajes en Serie.",
        "Al llegar a 30 s de marcha total, enciende H1 (Q0.1) y escribe una sola vez «Mantenimiento: 00:00:30 de marcha».",
        "En cada parada, escribe el uso desde que se encendió el PLC con un decimal: «Uso: 92.3 %».",
        "En una máquina real serían 500 horas: la regla es la misma."
      ],
      "uses": [
        "I0_0 · S1, MARCHA (NA)",
        "I0_1 · S2, PARO (NC)",
        "Q0_0 · KM1, motor",
        "Q0_1 · H1, mantenimiento"
      ],
      "teaches": "printf arma textos con formato (cifras, ceros a la izquierda, decimales) y una función convierte milisegundos en hh:mm:ss."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 0
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 0,
        "y": 600
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Paro"
        },
        "x": 220,
        "y": 600
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 760,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Mantenimiento"
        },
        "x": 440,
        "y": 600
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "color": "rojo"
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul"
      }
    ]
  }
}
