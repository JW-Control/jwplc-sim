{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 11 · Bloque de función propio: un motor",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-11",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "La bomba 2 (Q0.1) con otra instancia del bloque MOTOR (S3 marcha, S4 parada) y la lámpara H1 (Q0.2) encendida con cualquier bomba en marcha.",
      "steps": [
        "Ejecuta el ejemplo: S1 arranca la bomba 1 y S2 la detiene; mira el bloque MOTOR en pous/function-blocks.",
        "Declara BOMBA2 : MOTOR y llámala con S3 y S4; su salida Q a KM2.",
        "Enciende H1 con BOMBA1.Q OR BOMBA2.Q.",
        "Arranca las dos y detenlas por separado: cada instancia es independiente."
      ],
      "uses": [
        "%IX0.0 · S1, marcha bomba 1",
        "%IX0.1 · S2, parada bomba 1 (NC)",
        "%IX0.2 · S3, marcha bomba 2",
        "%IX0.3 · S4, parada bomba 2 (NC)",
        "%QX0.0 · KM1, bomba 1",
        "%QX0.1 · KM2, bomba 2",
        "%QX0.2 · H1, bombeando"
      ],
      "teaches": "Un FUNCTION_BLOCK propio se escribe una vez y se usa en cada equipo con su propia instancia, que guarda sus datos aparte, igual que una clase en C++."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha B1"
        },
        "x": 280,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Parada B1"
        },
        "x": 480,
        "y": 0
      },
      {
        "id": "S3",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha B2"
        },
        "x": 680,
        "y": 0
      },
      {
        "id": "S4",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Parada B2"
        },
        "x": 880,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "KM2",
        "type": "jwsim/contactor",
        "x": 560,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "verde",
          "label": "Bombeando"
        },
        "x": 840,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S3.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S3.14",
        "to": "plc.I0_2",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S4.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S4.12",
        "to": "plc.I0_3",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "KM2.A1",
        "color": "negro"
      },
      {
        "from": "KM2.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_2.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_2.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
