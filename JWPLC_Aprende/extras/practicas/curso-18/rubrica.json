  "id": "curso-18",
  "goals": [
    {
      "id": "cuenta",
      "description": "Da 6 toques a B1: «Paquete listo: 6 botellas»",
      "console": "Paquete listo: 6 botellas",
      "hint": "Mira botellas en E/S y variables mientras aprietas B1: ¿cuánto sube con un solo toque? Cuenta solo en el flanco de subida, como en la lección 07."
    },
    {
      "id": "golpe",
      "description": "Y1 (Q0.0) da un golpe de medio segundo",
      "when": {
        "Q0_0": 1
      },
      "hold_ms": 400,
      "after": "cuenta"
    },
    {
      "id": "uno",
      "description": "Y uno solo: Y1 queda quieto hasta la próxima botella",
      "when": {
        "Q0_0": 0
      },
      "hold_ms": 2000,
      "after": "golpe",
      "hint": "Pon un breakpoint en empujando = true; y mira botellas cuando se detiene la segunda vez: con 6 botellas la condición sigue cierta. Revisa el paquete solo en el momento en que cuentas una botella."
    },
    {
      "id": "paquetes",
      "description": "Cuenta los paquetes: «Paquetes: 1»",
      "console": "Paquetes: 1",
      "why": "Primero observar (variables y breakpoints), después cambiar: cada error se encontró mirando el dato justo donde se tomaba la decisión."
    }
  ],
