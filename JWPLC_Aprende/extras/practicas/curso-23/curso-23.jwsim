{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 23 · La microSD: un registro con fecha y hora",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/La_microSD/La_microSD.ino"
  },
  "exercise": {
    "lesson": "curso-23",
    "rubric": "./rubrica.json",
    "solution": "./solucion/La_microSD",
    "brief": {
      "goal": "Contar los eventos del registro al arrancar y avisar con H1 si falta la microSD.",
      "steps": [
        "Ejecuta el ejemplo: arranca y para el motor y aprieta OK en la botonera para ver el registro.",
        "Al arrancar el PLC, escribe «Registro: N eventos» con las líneas que ya tiene el archivo.",
        "Sin microSD (clic en su zócalo, en la pestaña Placa), H1 (Q0.1) se enciende y el motor sigue funcionando."
      ],
      "uses": [
        "I0_0 · S1, MARCHA (NA)",
        "I0_1 · S2, PARO (NC)",
        "Q0_0 · KM1, motor",
        "Q0_1 · H1, sin microSD",
        "Botonera: OK muestra el registro"
      ],
      "teaches": "Un archivo se abre, se escribe y se cierra; con FILE_APPEND cada línea se suma al final y el registro sobrevive a los cortes."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1,
    "rtc": "fijo:2026-11-24T08:00:00"
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 380,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Paro"
        },
        "x": 580,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Sin microSD"
        },
        "x": 560,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      }
    ]
  }
}
