  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Temporizadores/Temporizadores.ino"
  },
  "exercise": {
    "lesson": "curso-09",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Temporizadores",
    "brief": {
      "goal": "Arranque a los 2 s, luz de pasillo de 5 s y una bocina si la presencia dura más de 30 s.",
      "steps": [
        "Ejecuta el ejemplo: mantén S1 3 s y activa la presencia B1.",
        "Cambia el arranque a 2 s y la luz del pasillo a 5 s.",
        "Agrega un tercer temporizador: HA1 (Q0.2) suena si la presencia dura más de 30 s (en ×10 se espera menos)."
      ],
      "uses": [
        "I0_0 · S1, arranque",
        "I0_1 · B1, presencia (selector)",
        "Q0_0 · H1, arranque",
        "Q0_1 · H2, luz del pasillo",
        "Q0_2 · HA1, bocina"
      ],
      "teaches": "TON retarda la conexión, TOF retarda la desconexión; cada temporizador es un objeto con su propio tiempo."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 0
      },
      {
