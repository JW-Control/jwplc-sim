{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-26",
  "goals": [
    {
      "id": "marcha",
      "description": "MARCHA pone la bomba en marcha (KM1)",
      "when": {
        "Q0_0": 1
      },
      "hold_ms": 500,
      "hint": "Da un toque a S1 en Mandos y mira la pestaña Placa."
    },
    {
      "id": "arranques",
      "description": "Cuenta los arranques: «Arranques: 2»",
      "console": "Arranques: 2",
      "hint": "Detecta el flanco del motor (motor && !motorAntes), suma 1 y escribe con Serial.printf(\"Arranques: %lu\\n\", arranques). Para la pantalla, dibújalo abajo en jwplcUIUpdate().",
      "why": "El operador ve en el frente lo mismo que el técnico lee en la PC."
    },
    {
      "id": "falla",
      "description": "Abre el térmico F1: «Falla: térmico» y H1 (Q0.1) encendida",
      "console": "Falla: térmico",
      "hint": "termicoNormal = digitalRead(I0_2) == HIGH; falla = !termicoNormal; el motor pide !falla y H1 = falla."
    },
    {
      "id": "para",
      "description": "Con la falla, la bomba se detiene y H1 enciende",
      "when": {
        "Q0_0": 0,
        "Q0_1": 1
      },
      "hold_ms": 300,
      "after": "falla",
      "why": "La pantalla muestra FALLA en naranja: el operador sabe por qué paró sin abrir el tablero."
    }
  ],
