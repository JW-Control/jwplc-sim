  "goals": [
    {
      "id": "h1_arr",
      "description": "H1 (Q0.4) encendida durante el arranque escalonado",
      "when": {
        "Q0_3": 1,
        "Q0_0": 0,
        "Q0_4": 1
      },
      "hold_ms": 1000,
      "hint": "Al final de loop(): digitalWrite(Q0_4, arrancando || parando);"
    },
    {
      "id": "h1_todas",
      "description": "Con las cuatro cintas en marcha, H1 se apaga",
      "when": {
        "Q0_0": 1,
        "Q0_1": 1,
        "Q0_2": 1,
        "Q0_3": 1,
        "Q0_4": 0
      },
      "hold_ms": 500,
      "after": "h1_arr"
    },
    {
      "id": "vacia",
      "description": "PARADA apaga primero la cinta 1 y la 4 sigue",
      "when": {
        "Q0_0": 0,
        "Q0_3": 1
      },
      "hold_ms": 500,
      "after": "h1_todas",
      "hint": "Al apretar PARADA, en vez del for que apaga todas, empieza una secuencia como la de arranque pero con siguiente = 0 y sumando 1."
    },
    {
      "id": "orden",
      "description": "Luego la cinta 2, mientras la 3 sigue",
      "when": {
        "Q0_0": 0,
        "Q0_1": 0,
        "Q0_2": 1
      },
      "hold_ms": 500,
      "after": "vacia"
    },
    {
      "id": "h1_fin",
      "description": "Al final, las cuatro detenidas y H1 apagada",
      "when": {
        "Q0_0": 0,
        "Q0_1": 0,
        "Q0_2": 0,
        "Q0_3": 0,
        "Q0_4": 0
      },
      "hold_ms": 500,
      "after": "orden",
      "why": "La misma secuencia, recorrida al revés con el índice, vacía las cintas sin dejar material encima."
    }
  ],
