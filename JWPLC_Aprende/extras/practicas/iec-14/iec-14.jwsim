{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 14 · Sumar y restar: un estacionamiento",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-14",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Un estacionamiento de 3 lugares cuya cuenta nunca pasa de 3 ni baja de 0, aunque las barreras se accionen de más.",
      "steps": [
        "Ejecuta el ejemplo: S1 es un auto que entra y S2 uno que sale; con 5 adentro, H2 avisa lleno.",
        "Cambia la capacidad a 3.",
        "Suma solo si AUTOS < 3 y resta solo si AUTOS > 0.",
        "Prueba de más: entra un cuarto auto y salen más autos de los que hay; la cuenta no se sale de 0…3."
      ],
      "uses": [
        "%IX0.0 · S1, entra un auto",
        "%IX0.1 · S2, sale un auto",
        "%QX0.0 · H1, hay lugar",
        "%QX0.1 · H2, lleno"
      ],
      "teaches": "ADD y SUB cambian una cuenta en el flanco de un evento; una comparación antes de sumar o restar mantiene el número dentro de sus límites."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde"
        },
        "x": 380,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde"
        },
        "x": 580,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "verde",
          "label": "Q0.0"
        },
        "x": 280,
        "y": 1060
      },
      {
        "id": "H2",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Q0.1"
        },
        "x": 480,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S2.14",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H2.X1",
        "color": "negro"
      },
      {
        "from": "H2.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      }
    ]
  }
}
