  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Alarmas_en_pantalla/Alarmas_en_pantalla.ino"
  },
  "exercise": {
    "lesson": "curso-30",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Alarmas_en_pantalla",
    "brief": {
      "goal": "Que la bomba no arranque con una alarma sin reconocer y que avise con una ventana si marcha demasiado tiempo.",
      "steps": [
        "Ejecuta el ejemplo, arranca con S1 y abre F1: aparece la ventana A01 y H1 parpadea. OK en la Placa la reconoce.",
        "Sin reconocer A01, MARCHA no arranca: escribe «Reconozca la alarma A01».",
        "Agrega el aviso A02 (ventana WARN): con la bomba más de 15 s en marcha, «Alarma A02: marcha larga», una vez por arranque. La bomba sigue."
      ],
      "uses": [
        "I0_0 · S1, MARCHA (NA)",
        "I0_1 · S2, PARADA (NC)",
        "I0_2 · F1, térmico (NC)",
        "Q0_0 · KM1, bomba",
        "Q0_1 · H1, falla",
        "Botonera: OK reconoce",
        "Pantalla TFT: ventanas de alarma"
      ],
      "teaches": "Una alarma tiene dos estados: si la causa sigue y si alguien la reconoció. La lámpara y la ventana muestran los dos, como pide la norma de alarmas."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
