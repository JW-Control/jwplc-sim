{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 06 · Esperar sin detener el programa",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Tiempo_sin_delay/Tiempo_sin_delay.ino"
  },
  "exercise": {
    "lesson": "curso-06",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Tiempo_sin_delay",
    "brief": {
      "goal": "Una segunda intermitencia en Q0.2, cada 2 segundos, sin frenar la de Q0.0 ni el pulsador.",
      "steps": [
        "Ejecuta el ejemplo: H1 parpadea y H2 sigue a S1.",
        "Agrega otra variable de tiempo para Q0.2 con 2 s encendido y 2 s apagado.",
        "Comprueba que H1 sigue a su ritmo y que H2 responde a S1 al instante."
      ],
      "uses": [
        "I0_0 · S1, pulsador NA",
        "Q0_0 · H1, piloto verde",
        "Q0_1 · H2, piloto amarillo",
        "Q0_2 · H3, piloto rojo"
      ],
      "teaches": "Con millis() cada tarea lleva su propio reloj: varias intermitencias y el pulsador conviven sin delay()."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 0
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde"
        },
        "x": 0,
        "y": 600
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "verde",
          "label": "Q0.0"
        },
        "x": 220,
        "y": 600
      },
      {
        "id": "H2",
        "type": "jwsim/lamp",
        "params": {
          "color": "amarillo",
          "label": "Q0.1"
        },
        "x": 440,
        "y": 600
      },
      {
        "id": "H3",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Q0.2"
        },
        "x": 0,
        "y": 900
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H2.X1",
        "color": "negro"
      },
      {
        "from": "H2.X2",
        "to": "PS1.-V1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_2.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_2.2",
        "to": "H3.X1",
        "color": "negro"
      },
      {
        "from": "H3.X2",
        "to": "PS1.-V1",
        "color": "azul"
      }
    ]
  }
}
