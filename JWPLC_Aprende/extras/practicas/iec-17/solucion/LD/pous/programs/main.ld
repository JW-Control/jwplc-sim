    MARCHA AT %MW1 : INT; (* holding 40002: marcha, la escribe la PC *)
    META AT %MW2   : INT; (* holding 40003: meta de cajas, la escribe la PC *)
    F_CAJA         : R_TRIG;
    HAY_META       : BOOL; (* la PC fijó una meta *)
    LLENO          : BOOL; (* se llegó a la meta *)
  END_VAR

