  "goals": [
    {
      "id": "marcha",
      "description": "La PC arranca la banda con el 40002",
      "when": {
        "KM1.closed": true
      },
      "hold_ms": 500,
      "hint": "En la PC PC1, arrastra el valor del 40002 a la derecha."
    },
    {
      "id": "meta",
      "description": "Al llegar a la meta, la marcha vuelve a 0 sola",
      "when": {
        "KM1.closed": false,
        "PC1.h1": 0
      },
      "hold_ms": 500,
      "after": "marcha",
      "hint": "IF META > 0 AND CAJAS >= META THEN MARCHA := 0; END_IF;",
      "why": "Lo que escribe la PC es una variable más: el programa decide cuándo vale y cuándo se borra."
