{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 24 · El escaneo de E/S: las 8 entradas de una vez",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/El_escaneo_de_E_S/El_escaneo_de_E_S.ino"
  },
  "exercise": {
    "lesson": "curso-24",
    "rubric": "./rubrica.json",
    "solution": "./solucion/El_escaneo_de_E_S",
    "brief": {
      "goal": "Medir cuánto estuvo activa cada entrada y detectar los dos finales de carrera a la vez.",
      "steps": [
        "Ejecuta el ejemplo y aprieta las entradas: cada cambio sale en Serie y en las lámparas.",
        "Al soltar una entrada, escribe cuánto estuvo activa con un decimal: «I0.1 estuvo 1.2 s».",
        "Si B1 (I0.2) y B2 (I0.3) están activos a la vez, H5 (Q0.4) se enciende y escribe «Error: B1 y B2 a la vez»."
      ],
      "uses": [
        "I0_0 a I0_3 · S1, S2, B1, B2",
        "Q0_0 a Q0_3 · H1 a H4",
        "Q0_4 · H5, error"
      ],
      "teaches": "JWPLC_IO.inputs() da las 8 entradas en un byte; con & (máscara) y ^ (cambios) se revisan todas de una sola vez."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
