{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 03 · Enclavamiento: marcha y parada",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-03",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Piloto de marcha H2 (Q0.2) con el motor y piloto de falla H1 (Q0.1) mientras el térmico esté disparado.",
      "steps": [
        "Ejecuta el ejemplo: MARCHA arranca KM1 y sigue en marcha al soltarla.",
        "Agrega H2 encendido mientras el motor marcha.",
        "Agrega H1 encendido mientras el térmico (F1) esté disparado.",
        "Comprueba que al rearmar el térmico el motor NO arranca solo."
      ],
      "uses": [
        "%IX0.0 · S1, MARCHA (NA)",
        "%IX0.1 · S2, PARADA (NC)",
        "%IX0.2 · F1, térmico 95-96 (NC)",
        "%QX0.0 · KM1, contactor",
        "%QX0.1 · H1, falla",
        "%QX0.2 · H2, marcha"
      ],
      "teaches": "El enclavamiento es un contacto de KM1 en paralelo con MARCHA: la salida se mantiene sola hasta que algo en serie la corta."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 280,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Parada"
        },
        "x": 480,
        "y": 0
      },
      {
        "id": "F1",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "azul",
          "label": "Térmico 95-96"
        },
        "x": 680,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Falla"
        },
        "x": 560,
        "y": 1060
      },
      {
        "id": "H2",
        "type": "jwsim/lamp",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 760,
        "y": 1060
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC",
        "color": "rojo"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0",
        "color": "azul"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1",
        "color": "azul"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "F1.11",
        "color": "rojo",
        "ref": true
      },
      {
        "from": "F1.12",
        "to": "plc.I0_2",
        "color": "negro"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1",
        "color": "negro"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1",
        "color": "negro"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_2.1",
        "color": "rojo"
      },
      {
        "from": "plc.Q0_2.2",
        "to": "H2.X1",
        "color": "negro"
      },
      {
        "from": "H2.X2",
        "to": "PS1.-V1",
        "color": "azul",
        "ref": true
      }
    ]
  }
}
