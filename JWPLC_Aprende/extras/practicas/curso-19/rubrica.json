{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-19",
  "goals": [
    {
      "id": "ajuste",
      "description": "Ajusta el tiempo con UP o DOWN: «Tiempo: 4 s»",
      "console": "Tiempo: \\d+ s",
      "hint": "La botonera está en la pestaña Placa; también sirven las flechas del teclado."
    },
    {
      "id": "dosis",
      "description": "OK pone en marcha la bomba (Q0.0)",
      "when": {
        "Q0_0": 1
      },
      "hold_ms": 800
    },
    {
      "id": "limite",
      "description": "En el máximo, una sola vez: «Límite: 10 s»",
      "console": "Límite: 10 s",
      "hint": "Haz una función cambiarTiempo(int paso) que, si ya está en el límite, escriba el aviso en lugar de cambiar el número. Un bool enLimite evita repetirlo.",
      "why": "La máquina responde siempre: si no puede subir más, lo dice en vez de quedarse callada."
    },
    {
      "id": "repite",
      "description": "Mantén UP apretado: el tiempo sube solo hasta 9 s o más",
      "console": "Tiempo: (9|10) s",
      "after": "ajuste",
      "hint": "pressed() anota cuándo empezó la tecla; mientras isDown() siga en true y pasen 600 ms, cambia un paso cada 200 ms (lección 06).",
      "why": "pressed() es un evento (una vez por pulsación); isDown() es un estado (mientras siga apretada)."
    }
  ],
