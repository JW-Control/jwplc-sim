  "id": "curso-05",
  "goals": [
    {
      "id": "cruce_a",
      "description": "I0.0 manda Q0.7 (y no Q0.0)",
      "when": {
        "I0_0": 1,
        "I0_7": 0,
        "Q0_7": 1,
        "Q0_0": 0
      },
      "hold_ms": 600,
      "hint": "for (uint8_t i = 0; i < 8; i++) digitalWrite(Q0_X[7 - i], bitRead(entradas, i));"
    },
    {
      "id": "cruce_b",
      "description": "I0.7 manda Q0.0 (y no Q0.7)",
      "when": {
        "I0_7": 1,
        "I0_0": 0,
        "Q0_0": 1,
        "Q0_7": 0
      },
      "hold_ms": 600
    },
    {
      "id": "cuenta",
      "description": "El Monitor Serie muestra «Activas: N»",
      "console": "^Activas:\\s*\\d+\\s*$",
      "hint": "Suma bitRead(entradas, i) en una variable dentro del for.",
      "why": "Contar bits es la base para saber cuántos sensores están activos."
    }
  ],
