  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Las_8_entradas_y_salidas/Las_8_entradas_y_salidas.ino"
  },
  "exercise": {
    "lesson": "curso-05",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Las_8_entradas_y_salidas",
    "brief": {
      "goal": "Cruza las salidas (I0.0 manda Q0.7 … I0.7 manda Q0.0) y muestra cuántas entradas están activas.",
      "steps": [
        "Ejecuta el ejemplo y mueve los selectores: cada piloto sigue a su entrada.",
        "Cruza las salidas con un for y digitalWrite(Q0_X[7 - i], …).",
        "Cuenta las entradas activas y escribe «Activas: N» en el Monitor Serie.",
        "Prueba con varias entradas a la vez."
      ],
      "uses": [
        "I0_0…I0_7 · SA1…SA8, selectores",
        "Q0_0…Q0_7 · H1…H8, pilotos",
        "Monitor Serie a 115200 baudios"
      ],
      "teaches": "Un byte guarda las 8 entradas; bitRead() saca cada bit; un for repite lo mismo para las 8 salidas."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
