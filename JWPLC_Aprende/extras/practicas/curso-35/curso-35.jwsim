        "to": "PS1.-V2"
      },
      {
        "from": "IO1.DC",
        "to": "PS1.-V2"
      },
      {
        "from": "plc.RS485_A",
        "to": "IO1.A"
      },
      {
        "from": "plc.RS485_B",
        "to": "IO1.B"
      },
      {
        "from": "PS1.+V2",
        "to": "S1.13",
