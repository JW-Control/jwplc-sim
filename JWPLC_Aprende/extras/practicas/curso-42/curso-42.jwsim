{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 42 · Rampas",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Rampas/Rampas.ino"
  },
  "exercise": {
    "lesson": "curso-42",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Rampas",
    "brief": {
      "goal": "Rampa de bajada: la parada baja la frecuencia a 10 Hz/s hasta 0 y recién entonces manda la orden de parada.",
      "steps": [
        "Ejecuta el ejemplo: S1 sube la frecuencia de a 5 Hz/s hasta 50 Hz y S2 corta de golpe.",
        "Con S2, pon el objetivo en 0 y sigue con la rampa, ahora de 10 Hz/s (dos pasos por ciclo, o un paso de bajada aparte).",
        "Cuando la rampa llega a 0: la orden de parada al variador y «Detenido en rampa»."
      ],
      "uses": [
        "I0_0 · S1, marcha (NA)",
        "I0_1 · S2, parada (NC)",
        "RS-485 · VF1, variador, dirección 1",
        "2000H · orden, 2001H · frecuencia × 100"
      ],
      "teaches": "Una rampa acerca un valor a su objetivo de a pasos pequeños, sin pasarse. Arrancar y parar en rampa cuida la tubería, el motor y la carga."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 360
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 380,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "rojo",
          "label": "Parada"
        },
        "x": 580,
        "y": 0
      },
      {
        "id": "L1",
        "type": "jwsim/power-230vac",
        "x": 0,
        "y": 760
      },
      {
        "id": "VF1",
        "type": "jwsim/vfd-el",
        "x": 820,
        "y": 360,
        "params": {
          "02-00": "3: RS-485",
          "02-01": "3: RS-485, STOP/RESET del teclado habilitado",
          "09-01": "1: 9600 bps",
          "09-04": "6: RTU 8,N,1",
          "09-02": "1: advertir y parar en rampa",
          "09-03": 3,
          "01-09": 3,
          "01-10": 3,
          "09-00": 1
        }
      },
      {
        "id": "M1",
        "type": "jwsim/motor-3ph",
        "x": 980,
        "y": 1180
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "S2.11",
        "ref": true
      },
      {
        "from": "S2.12",
        "to": "plc.I0_1"
      },
      {
        "from": "L1.L",
        "to": "VF1.R",
        "ref": true
      },
      {
        "from": "L1.N",
        "to": "VF1.S",
        "ref": true
      },
      {
        "from": "VF1.U",
        "to": "M1.U1"
      },
      {
        "from": "VF1.V",
        "to": "M1.V1"
      },
      {
        "from": "VF1.W",
        "to": "M1.W1"
      },
      {
        "from": "plc.RS485_A",
        "to": "VF1.SG+"
      },
      {
        "from": "plc.RS485_B",
        "to": "VF1.SG-"
      }
    ]
  }
}
