{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 37 · Varios equipos en el bus",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Varios_equipos_en_el_bus/Varios_equipos_en_el_bus.ino"
  },
  "exercise": {
    "lesson": "curso-37",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Varios_equipos_en_el_bus",
    "brief": {
      "goal": "Sumar la puerta del horno (DI1 del módulo) y la lámpara de alarma (DO2): con la puerta abierta el ventilador para; con la alarma del controlador, H2.",
      "steps": [
        "Ejecuta el ejemplo: sube la temperatura de TC1 a 47 °C y el ventilador KM1 arranca por DO1; a 40 °C para.",
        "Lee las entradas del módulo: con S1 (puerta) en I, el ventilador para y se escribe «Puerta abierta» una vez.",
        "Con el bit 1 del estado de TC1 (alarma), enciende H2 en DO2."
      ],
      "uses": [
        "RS-485 · TC1, controlador, dirección 1",
        "RS-485 · IO1, E/S remotas, dirección 3",
        "DI1 · S1, puerta del horno",
        "DO1 · KM1, ventilador",
        "DO2 · H2, alarma"
      ],
      "teaches": "Varios esclavos comparten el bus porque cada uno tiene su dirección: el maestro les pregunta por turno, uno a la vez."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 420
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 420
      },
      {
        "id": "TC1",
        "type": "jwsim/temp-controller",
        "params": {
          "address": 1,
          "baud": "9600",
          "coil": "24VDC",
          "sonda": "simulada",
          "temp": 30,
          "sv": 40,
          "hist": 2,
          "alarma": 10
        },
        "x": 420,
        "y": 0
      },
      {
        "id": "IO1",
        "type": "jwsim/remote-io",
        "params": {
          "address": 3,
          "baud": "9600"
        },
        "x": 1580,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/selector-2",
        "params": {
          "label": "Puerta"
        },
        "x": 820,
        "y": 420
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 1020,
        "y": 420
      },
      {
        "id": "H2",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Alarma"
        },
        "x": 1300,
        "y": 420
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V2",
        "to": "TC1.L",
        "ref": true
      },
      {
        "from": "TC1.N",
        "to": "PS1.-V2",
        "ref": true
      },
      {
        "from": "PS1.+V2",
        "to": "IO1.+"
      },
      {
        "from": "IO1.-",
        "to": "PS1.-V2"
      },
      {
        "from": "IO1.DC",
        "to": "PS1.-V2"
      },
      {
        "from": "plc.RS485_A",
        "to": "TC1.A"
      },
      {
        "from": "plc.RS485_B",
        "to": "TC1.B"
      },
      {
        "from": "TC1.A",
        "to": "IO1.A"
      },
      {
        "from": "TC1.B",
        "to": "IO1.B"
      },
      {
        "from": "PS1.+V2",
        "to": "S1.13",
        "ref": true
      },
      {
        "from": "S1.14",
        "to": "IO1.DI1"
      },
      {
        "from": "PS1.+V2",
        "to": "IO1.C1"
      },
      {
        "from": "IO1.DO1",
        "to": "KM1.A1"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V2",
        "ref": true
      },
      {
        "from": "IO1.DO2",
        "to": "H2.X1"
      },
      {
        "from": "H2.X2",
        "to": "PS1.-V2",
        "ref": true
      }
    ]
  }
}
