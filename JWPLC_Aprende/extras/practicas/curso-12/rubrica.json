{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-12",
  "goals": [
    {
      "id": "h1_b1",
      "description": "H1 (Q0.2) encendida con la bomba 1 en marcha",
      "when": {
        "Q0_0": 1,
        "Q0_2": 1
      },
      "hold_ms": 500,
      "hint": "Al final de loop(): digitalWrite(Q0_2, bomba1.estaEnMarcha() || bomba2.estaEnMarcha());"
    },
    {
      "id": "h1_b2",
      "description": "H1 sigue encendida con solo la bomba 2 en marcha",
      "when": {
        "Q0_0": 0,
        "Q0_1": 1,
        "Q0_2": 1
      },
      "hold_ms": 500,
      "after": "h1_b1"
    },
    {
      "id": "h1_off",
      "description": "H1 se apaga con las dos bombas detenidas",
      "when": {
        "Q0_0": 0,
        "Q0_1": 0,
        "Q0_2": 0
      },
      "hold_ms": 300,
      "after": "h1_b2",
      "why": "Preguntas a cada objeto por su estado con objeto.funcion(): no hace falta saber cómo lo guarda por dentro."
    },
    {
      "id": "cuenta",
      "description": "Arranca dos veces la bomba 1: «Bomba 1 en marcha (arranque 2)»",
      "console": "Bomba 1 en marcha \\(arranque 2\\)",
      "hint": "Un dato privado uint32_t arranques = 0; que arrancar() suma antes de escribir el mensaje."
    },
    {
      "id": "propia",
      "description": "Luego arranca la bomba 2: su cuenta empieza en 1",
      "console": "Bomba 2 en marcha \\(arranque 1\\)",
      "after": "cuenta",
      "why": "Cada objeto lleva sus propios datos: la cuenta de la bomba 1 no se mezcla con la de la bomba 2."
    }
  ],
