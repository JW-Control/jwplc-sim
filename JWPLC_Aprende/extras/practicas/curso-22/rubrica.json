{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-22",
  "goals": [
    {
      "id": "cuenta",
      "description": "Da toques a B1: «Piezas: 3»",
      "console": "Piezas: [3-9]",
      "hint": "Cada toque a B1 es una pieza."
    },
    {
      "id": "corte",
      "description": "Detén y vuelve a ejecutar: «Recuperado: … piezas»",
      "console": "Recuperado: [1-9]\\d* piezas",
      "hint": "Detener y Ejecutar en el Sim es como cortar la energía: la FRAM conserva lo que tenía."
    },
    {
      "id": "encendidos",
      "description": "Al arrancar otra vez: «Encendido n.º 2» (o más)",
      "console": "Encendido n\\.º ([2-9]|\\d\\d)",
      "hint": "Agrega unsigned long encendidos; al struct, súmale 1 en setup() y guarda. Sube VERSION a 2: el bloque viejo deja de valer y arranca en 0.",
      "why": "Contar los arranques ayuda a diagnosticar: si el PLC se reinicia solo, el número sube sin que nadie lo apague."
    },
    {
      "id": "borra",
      "description": "ESC mantenido 2 s: «Contador en 0»",
      "console": "Contador en 0",
      "hint": "isDown(BTN_ESC) con un tiempo, como el TON de la lección 09: un toque suelto no borra nada."
    }
  ],
