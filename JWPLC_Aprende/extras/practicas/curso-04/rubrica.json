{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-04",
  "goals": [
    {
      "id": "tres",
      "description": "Con las tres manos, H1 (Q0.0) enciende",
      "when": {
        "I0_0": 1,
        "I0_1": 1,
        "I0_2": 1,
        "Q0_0": 1
      },
      "hold_ms": 500,
      "hint": "if (manoIzquierda && manoDerecha && terceraMano)"
    },
    {
      "id": "dos_no",
      "description": "Con dos manos, H1 queda apagado",
      "when": {
        "I0_0": 1,
        "I0_1": 1,
        "I0_2": 0,
        "Q0_0": 0
      },
      "after": "tres",
      "hold_ms": 500,
      "why": "Una prensa a varias manos obliga a tener las dos (o tres) manos fuera de la zona de peligro."
    },
    {
      "id": "q4",
      "description": "H5 (Q0.4) enciende con I0.0 activa e I0.1 inactiva",
      "when": {
        "I0_0": 1,
        "I0_1": 0,
        "Q0_4": 1
      },
      "hold_ms": 500,
      "hint": "digitalWrite(Q0_4, manoIzquierda && !manoDerecha);"
    },
    {
      "id": "q4_no",
      "description": "Con I0.1 activa, H5 se apaga",
      "when": {
        "I0_0": 1,
        "I0_1": 1,
        "Q0_4": 0
      },
      "after": "q4",
      "hold_ms": 500
    }
  ],
