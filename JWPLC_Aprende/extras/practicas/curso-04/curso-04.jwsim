{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Lección 04 · Variables y decisiones",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/Variables_y_decisiones/Variables_y_decisiones.ino"
  },
  "exercise": {
    "lesson": "curso-04",
    "rubric": "./rubrica.json",
    "solution": "./solucion/Variables_y_decisiones",
    "brief": {
      "goal": "Prensa a tres manos en Q0.0 y Q0.4 encendido con I0.0 activa pero I0.1 inactiva.",
      "steps": [
        "Ejecuta el ejemplo y prueba los selectores (en el banco son las «manos»).",
        "Agrega la tercera mano en I0_2: Q0.0 solo con las tres.",
        "Q0.4: encendido con I0.0 activa y I0.1 inactiva (&& y !).",
        "Prueba las combinaciones en la escena."
      ],
      "uses": [
        "I0_0 · SA1, mano izquierda",
        "I0_1 · SA2, mano derecha",
        "I0_2 · SA3, tercera mano",
        "Q0_0…Q0_4 · H1…H5, pilotos"
      ],
      "teaches": "&& (Y), || (O), ! (NO) y != combinan entradas en una decisión; un bool se escribe directo en una salida."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 0
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "SA1",
        "type": "jwsim/selector-2",
        "params": {
          "label": "Mano izq."
        },
        "x": 0,
        "y": 600
      },
      {
        "id": "SA2",
