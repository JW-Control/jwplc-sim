        {
          "at_ms": 2500,
          "device": "B1",
          "action": "actuate",
          "value": true
        }
      ],
      "checks": [
        {
          "description": "Abrir cierra KM1 (requisito)",
          "points": 2,
          "prerequisite": true,
          "at_ms": 1200,
          "expect": {
