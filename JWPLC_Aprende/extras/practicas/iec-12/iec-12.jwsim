{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 12 · Proyecto: un portón automático",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-12",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Si la barrera B3 ve un obstáculo mientras el portón cierra, vuelve a abrir; y la baliza H1 (Q0.2) encendida mientras el portón se mueve.",
      "steps": [
        "Ejecuta el ejemplo: S1 abre hasta B1, S2 cierra hasta B2 y S0 lo detiene donde esté.",
        "En la etapa CERRANDO agrega la transición a ABRIENDO con B3.",
        "Enciende H1 en cualquier etapa menos la 0.",
        "Prueba un obstáculo a mitad del cierre: KM2 abre y KM1 cierra, nunca los dos a la vez."
      ],
      "uses": [
        "%IX0.0 · S1, abrir",
        "%IX0.1 · S2, cerrar",
        "%IX0.2 · S0, parada NC",
        "%IX0.3 · B1, abierto",
        "%IX0.4 · B2, cerrado",
        "%IX0.5 · B3, barrera",
        "%QX0.0 · KM1, abrir",
        "%QX0.1 · KM2, cerrar",
        "%QX0.2 · H1, baliza"
      ],
      "teaches": "Una máquina real se ordena en etapas: cada una revisa solo sus salidas posibles, y la seguridad (parada, obstáculo) es una transición más."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "label": "Abrir",
          "color": "verde"
        },
        "x": 820,
        "y": 0
      },
      {
        "id": "S2",
        "type": "jwsim/pushbutton-no",
