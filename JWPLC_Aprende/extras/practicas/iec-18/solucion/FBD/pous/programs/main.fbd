    P_MARCHA AT %MW1 : INT; (* holding 40002: pulsador remoto MARCHA *)
    P_PARO AT %MW2   : INT; (* holding 40003: pulsador remoto PARO *)
    P_CERO AT %MW3   : INT; (* holding 40004: pulsador remoto contador a cero *)
    F_CAJA           : R_TRIG;
    CAJA             : BOOL; (* flanco de B1 *)
  END_VAR

