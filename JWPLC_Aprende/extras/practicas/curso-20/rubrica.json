{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "curso-20",
  "goals": [
    {
      "id": "aviso",
      "description": "MARCHA: «Aviso de arranque» y el motor arranca 2 s después",
      "console": "Motor en marcha",
      "hint": "Da un toque a S1 en Mandos."
    },
    {
      "id": "falla",
      "description": "Abre el térmico F1: «Falla: térmico»",
      "console": "Falla: térmico"
    },
    {
      "id": "parpadeo",
      "description": "Sin reconocer, H1 (Q0.1) parpadea",
      "period": "Q0_1",
      "on_ms": [
        350,
        650
      ],
      "off_ms": [
        350,
        650
      ],
      "cycles": 2,
      "after": "falla",
      "hint": "bool luz = falla && (reconocida || (millis() / 500) % 2 == 0); y digitalWrite(Q0_1, luz);",
      "why": "Parpadeo = alarma nueva sin atender; fija = ya la vio alguien. Así se lee un tablero de un vistazo."
    },
    {
      "id": "reconoce",
      "description": "OK en la botonera: «Alarma reconocida»",
      "console": "Alarma reconocida",
      "after": "falla"
    },
    {
      "id": "bloqueo",
      "description": "Con la falla activa, MARCHA: «Bloqueado: térmico abierto»",
      "console": "Bloqueado: térmico abierto",
      "hint": "Detecta el flanco de MARCHA; si hay falla, escribe el aviso y da un beep grave: JWPLC_Buzzer.beep(300, 600)."
    }
  ],
