          "color": "rojo",
          "label": "Paro"
        },
        "x": 480,
        "y": 0
      },
      {
        "id": "F1",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "color": "azul",
          "label": "Térmico 95-96"
        },
        "x": 680,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 280,
        "y": 1060
      },
      {
        "id": "H1",
