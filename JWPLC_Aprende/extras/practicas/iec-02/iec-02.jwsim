{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "IEC · Lección 02 · Lógica Y, O, NO",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "openplc",
    "project": "./iniciar/ST"
  },
  "exercise": {
    "lesson": "iec-02",
    "rubric": "./rubrica.json",
    "solution": "./solucion/ST",
    "brief": {
      "goal": "Prensa a tres manos en H1 (Q0.0) y H5 (Q0.4) encendido con SA1 activa pero SA2 inactiva.",
      "steps": [
        "Ejecuta el ejemplo y prueba los selectores (en el banco son las «manos»).",
        "Agrega la tercera mano SA3: H1 solo con las tres.",
        "H5: encendido con SA1 activa y SA2 inactiva.",
        "Prueba todas las combinaciones."
      ],
      "uses": [
        "%IX0.0 · SA1, mano izquierda",
        "%IX0.1 · SA2, mano derecha",
        "%IX0.2 · SA3, tercera mano",
        "%QX0.0…%QX0.4 · H1…H5, pilotos"
      ],
      "teaches": "Y son contactos en serie (AND), O son contactos en paralelo (OR) y NO es un contacto cerrado (NOT)."
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "x": 0,
        "y": 360
      },
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 280,
        "y": 360
      },
      {
        "id": "SA1",
        "type": "jwsim/selector-2",
        "params": {
          "label": "Mano izq."
        },
        "x": 280,
        "y": 0
      },
      {
        "id": "SA2",
        "type": "jwsim/selector-2",
        "params": {
          "label": "Mano der."
        },
        "x": 480,
        "y": 0
      },
      {
        "id": "SA3",
        "type": "jwsim/selector-2",
        "params": {
          "label": "Tercera mano"
        },
        "x": 680,
        "y": 0
      },
      {
        "id": "H1",
