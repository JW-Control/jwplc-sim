  "id": "curso-16",
  "goals": [
    {
      "id": "aviso",
      "description": "Con MARCHA, la sirena HA1 (Q0.3) suena y el motor todavía no arranca",
      "when": {
        "Q0_3": 1,
        "Q0_0": 0
      },
      "hold_ms": 1000,
      "hint": "En D_Logica: ordenMarcha = (pbMarcha || ordenMarcha) && !pbParo && !fallaTermico; motor = tAviso.ejecutar(ordenMarcha, T_AVISO_ARRANQUE_MS); sirena = ordenMarcha && !motor;"
    },
    {
      "id": "arranca",
      "description": "A los 2 s calla la sirena, arranca el motor y enciende H2 (Q0.2)",
      "when": {
        "Q0_0": 1,
        "Q0_2": 1,
        "Q0_3": 0
      },
      "hold_ms": 1000,
      "after": "aviso",
      "hint": "Una salida nueva toca tres pestañas: su bit en B_Tags.h, la decisión en D_Logica y su bitWrite() en F_Salidas."
    },
    {
      "id": "paro",
      "description": "PARO detiene el motor y apaga H2",
      "when": {
        "Q0_0": 0,
        "Q0_2": 0,
        "Q0_3": 0
      },
      "hold_ms": 500,
      "after": "arranca"
    },
    {
      "id": "termico",
      "description": "Arranca de nuevo y dispara el térmico F1: se detiene y enciende H1",
      "when": {
        "Q0_0": 0,
        "Q0_1": 1
      },
      "hold_ms": 300,
      "after": "paro",
      "why": "Cada cambio fue a su pestaña: los bits en B_Tags, el tiempo en A_Config, la decisión en D_Logica y la escritura en F_Salidas."
    }
  ],
