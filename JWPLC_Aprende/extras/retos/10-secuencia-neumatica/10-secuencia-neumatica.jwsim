{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Secuencia electroneumática de 4 cilindros",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.17"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/secuencia_neumatica/secuencia_neumatica.ino"
  },
  "exercise": {
    "level": 3,
    "statement": "./ENUNCIADO.md",
    "rubric": "./rubrica.json",
    "solution": "./solucion/secuencia_neumatica",
    "brief": {
      "goal": "Cuatro cilindros neumáticos que siguen la secuencia A+ B+ B− A− C+ D+ D− C− en ciclo continuo, vigilada por sus finales de carrera de rodillo.",
      "steps": [
        "OK arranca el ciclo continuo si los cuatro cilindros están en reposo.",
        "Cada paso espera su final de carrera; si no llega en 3 s, la máquina queda en falla con el código en ERR.",
        "ESC pausa en el paso actual y OK continúa.",
        "LEFT (Reset) retrae todos los cilindros y deja la máquina lista."
      ],
      "teaches": "Secuencias electroneumáticas con finales de carrera, vigilancia por tiempo, pausa y reset.",
      "uses": [
        "I0_0 · A0, final de carrera de rodillo: cilindro A retraído",
        "I0_1 · A1, final de carrera de rodillo: cilindro A extendido",
        "I0_2 · B0, final de carrera de rodillo: cilindro B retraído",
        "I0_3 · B1, final de carrera de rodillo: cilindro B extendido",
        "I0_4 · C0, final de carrera de rodillo: cilindro C retraído",
        "I0_5 · C1, final de carrera de rodillo: cilindro C extendido",
        "I0_6 · D0, final de carrera de rodillo: cilindro D retraído",
        "I0_7 · D1, final de carrera de rodillo: cilindro D extendido",
        "Q0_0 · Y1, electroválvula 5/2: cilindro A",
        "Q0_1 · Y2, electroválvula 5/2: cilindro B",
        "Q0_2 · Y3, electroválvula 5/2: cilindro C",
        "Q0_3 · Y4, electroválvula 5/2: cilindro D",
        "Q0_4 · H1, piloto verde: en marcha",
        "Q0_5 · H2, piloto amarillo: pausa",
        "Q0_6 · H3, piloto rojo: falla",
        "Botones del frente: OK Arranque, ESC Pausa, LEFT Reset"
      ]
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
