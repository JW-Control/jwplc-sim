{
  "$schema": "../../../../schema/jwsim-rubric-1.json",
  "id": "04-bomba-niveles",
  "goals": [
    {
      "id": "vacio",
      "description": "Tanque vacío: la bomba arranca y H1 avisa nivel bajo",
      "when": {
        "B1.actuated": false,
        "KM1.closed": true,
        "H1.lit": true
      },
      "hold_ms": 1000
    },
    {
      "id": "sobre_b1",
      "description": "Acciona B1 (el agua lo pasa): la bomba sigue llenando",
      "when": {
        "B1.actuated": true,
        "B2.actuated": false,
        "KM1.closed": true,
        "H1.lit": false
      },
      "after": "vacio",
      "hold_ms": 800,
      "hint": "Entre B1 y B2 la bomba conserva lo que estaba haciendo: histéresis."
    },
    {
      "id": "lleno",
      "description": "Acciona B2: la bomba para",
      "when": {
        "B2.actuated": true,
        "KM1.closed": false
      },
      "after": "sobre_b1",
      "hold_ms": 800
    },
    {
      "id": "bajando",
      "description": "Suelta B2: entre B2 y B1 la bomba no arranca",
      "when": {
        "B1.actuated": true,
        "B2.actuated": false,
        "KM1.closed": false
      },
      "after": "lleno",
      "hold_ms": 800
    },
    {
      "id": "rearranca",
      "description": "Suelta B1: bajo B1 vuelve a llenar",
      "when": {
        "B1.actuated": false,
        "KM1.closed": true
      },
      "after": "bajando",
      "hold_ms": 800
    }
  ],
  "cases": [
    {
      "name": "Llenado desde vacío",
      "until_ms": 3500,
      "actions": [
        {
          "at_ms": 1500,
          "device": "B1",
          "action": "actuate",
          "value": true
        },
        {
          "at_ms": 2500,
          "device": "B2",
          "action": "actuate",
          "value": true
        }
      ],
      "checks": [
        {
          "description": "Con el tanque vacío arranca la bomba (requisito)",
          "points": 2,
          "prerequisite": true,
          "at_ms": 1200,
          "expect": {
            "KM1.closed": true
          }
        },
        {
          "description": "Piloto de tanque bajo encendido",
          "points": 1,
          "at_ms": 1200,
          "expect": {
            "H1.lit": true
          }
        },
        {
          "description": "Sigue llenando al pasar B1",
          "points": 2,
          "from_ms": 1600,
          "to_ms": 2450,
          "always": {
            "KM1.closed": true
          }
        },
        {
          "description": "Para al llegar a B2",
          "points": 2,
          "at_ms": 2700,
          "expect": {
            "KM1.closed": false
          }
        },
        {
          "description": "Piloto apagado sobre B1",
          "points": 1,
          "at_ms": 2700,
          "expect": {
            "H1.lit": false
          }
        }
      ]
    },
    {
      "name": "Vaciado desde lleno",
      "until_ms": 3500,
      "actions": [
        {
          "at_ms": 0,
          "device": "B1",
          "action": "actuate",
          "value": true
        },
        {
          "at_ms": 0,
          "device": "B2",
          "action": "actuate",
          "value": true
        },
        {
          "at_ms": 1500,
          "device": "B2",
          "action": "actuate",
          "value": false
        },
        {
          "at_ms": 2500,
          "device": "B1",
          "action": "actuate",
          "value": false
        }
      ],
      "checks": [
        {
          "description": "Lleno: la bomba está parada",
          "points": 1,
          "at_ms": 1200,
          "expect": {
            "KM1.closed": false
          }
        },
        {
          "description": "Entre B2 y B1 no arranca",
          "points": 2,
          "from_ms": 1500,
          "to_ms": 2450,
          "always": {
            "KM1.closed": false
          }
        },
        {
          "description": "Bajo B1 arranca (requisito)",
          "points": 2,
          "prerequisite": true,
          "at_ms": 2700,
          "expect": {
            "KM1.closed": true
          }
        },
        {
          "description": "Piloto de tanque bajo",
          "points": 1,
          "at_ms": 2700,
          "expect": {
            "H1.lit": true
          }
        }
      ]
    }
  ],
  "goal_runs": [
    {
      "name": "Llena, para y vuelve a llenar",
      "until_ms": 9000,
      "actions": [
        {
          "at_ms": 2500,
          "device": "B1",
          "action": "actuate",
          "value": true
        },
        {
          "at_ms": 4000,
          "device": "B2",
          "action": "actuate",
          "value": true
        },
        {
          "at_ms": 5500,
          "device": "B2",
          "action": "actuate",
          "value": false
        },
        {
          "at_ms": 7000,
          "device": "B1",
          "action": "actuate",
          "value": false
        }
      ]
    }
  ]
}
