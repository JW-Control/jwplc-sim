{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-control.github.io/jwplc-sim/schema/jwsim-scene-1.json",
  "title": "Escena de JWPLC Sim v1",
  "description": "Dispositivos y cableado borne a borne (campo 'scene' de un proyecto .jwsim o archivo de escena). Ver docs/ARCHITECTURE.md §4.1.",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "$comment": { "type": "string" },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "description": "Identificador en la escena (KM1, S0, plc)." },
          "type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$", "description": "autor/nombre del dispositivo (jwsim/contactor)." },
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Versión mínima requerida (misma versión mayor)." },
          "params": { "type": "object" },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "rotation": { "enum": [0, 90, 180, 270] },
          "mount": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$", "description": "Id del equipo al que va acoplado sin cables (relé térmico bajo el contactor). Ver scene/mount.mjs." },
          "p3": {
            "type": "object",
            "description": "Lugar del equipo en la Planta 3D armada a mano (metros y grados). Sin p3 se acomoda solo.",
            "required": ["x", "z"],
            "properties": { "x": { "type": "number" }, "z": { "type": "number" }, "r": { "enum": [0, 90, 180, 270] } }
          }
        }
      }
    },
    "wiring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*\\..+$", "description": "Borne '<dispositivo>.<borne>' (PS1.L+, plc.Q0_0.1)." },
          "to": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*\\..+$" },
          "color": { "type": "string" },
          "points": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } },
          "cable": { "type": "string", "description": "Id del cable multipolar (cables) en que va este hilo. Solo dibujo: el simulador usa from/to." },
          "ref": { "type": "boolean", "description": "Se dibuja como referencia: un tramo corto en cada borne con su destino, sin el recorrido largo." }
        }
      }
    },
    "cables": {
      "type": "array",
      "description": "Cables multipolares: hilos entre dos equipos que se dibujan juntos en una funda (solo dibujo).",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "description": "W1, W2…" },
          "label": { "type": "string", "description": "Nombre o sección (p. ej. 4×1 mm² mando)." },
          "ref": { "type": "boolean", "description": "Se dibuja como referencia: sin el tronco, un rótulo en cada salida." }
        }
      }
    },
    "plant3d": {
      "type": "object",
      "description": "Planta 3D armada a mano: rejilla, lugar del tablero y piezas de ambiente sin E/S (barandas, plataformas, cercos, pisos).",
      "properties": {
        "grid": { "enum": [0.25, 0.5] },
        "panel": { "type": "object", "required": ["x", "z"], "properties": { "x": { "type": "number" }, "z": { "type": "number" }, "r": { "enum": [0, 90, 180, 270] } } },
        "pieces": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "x", "z"],
            "properties": {
              "id": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$" },
              "kind": { "enum": ["plataforma", "escalera", "baranda", "cerco", "poste", "franja", "paso", "piso", "caja", "pallet"] },
              "x": { "type": "number" },
              "z": { "type": "number" },
              "r": { "enum": [0, 90, 180, 270] },
              "params": { "type": "object", "description": "Medidas de la pieza (ancho, largo, alto en metros)." }
            }
          }
        }
      }
    }
  }
}
