{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-control.github.io/jwplc-sim/schema/jwsim-rubric-1.json",
  "title": "Rúbrica de un ejercicio de JWPLC Sim (G9)",
  "description": "Casos co-simulados con la escena del ejercicio; cada verificación es una tabla de verdad temporizada sobre la traza. La nota es 20 × puntos obtenidos / puntos totales.",
  "type": "object",
  "required": [
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "$comment": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "goals": {
      "description": "Objetivos en vivo (opcional): mientras el alumno opera la escena, cada uno se cumple cuando 'when' se sostiene 'hold_ms' de tiempo simulado. No dan nota.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "name",
        "until_ms",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "until_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "actions": {
          "$ref": "jwsim-test-1.json#/$defs/run/properties/actions"
        },
        "faults": {
          "$ref": "jwsim-test-1.json#/$defs/run/properties/faults"
        },
        "stim": {
          "type": "array",
          "description": "Líneas de estímulo de la placa en el formato .stim («1500 BTN_OK=1»): sirven para los botones del frente (BTN_*), que no son dispositivos de la escena.",
          "items": {
            "type": "string"
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "description"
      ],
      "additionalProperties": false,
      "description": "Una sola de expect (con at_ms), always/never/eventually (con from_ms y to_ms), console, no_faults, period o responds.",
      "properties": {
        "description": {
          "type": "string"
        },
        "points": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "prerequisite": {
          "type": "boolean",
          "description": "Requisito del caso: si falla, las demás verificaciones del caso no suman."
        },
        "at_ms": {
          "type": "number",
          "minimum": 0
        },
        "from_ms": {
          "type": "number",
          "minimum": 0
        },
        "to_ms": {
          "type": "number",
          "minimum": 0
        },
        "for_ms": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Con eventually: la condición se sostiene al menos este tiempo."
        },
        "expect": {
          "type": "object",
          "minProperties": 1,
          "description": "Señales de la placa (Q0_k, I0_k) o salidas de equipos de la escena (\"KM1.closed\") con su valor esperado.",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "always": {
          "type": "object",
          "minProperties": 1,
          "description": "Señales de la placa (Q0_k, I0_k) o salidas de equipos de la escena (\"KM1.closed\") con su valor esperado.",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "never": {
          "type": "object",
          "minProperties": 1,
          "description": "Nunca se cumplen todas a la vez (enclavamientos).",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "eventually": {
          "type": "object",
          "minProperties": 1,
          "description": "Señales de la placa (Q0_k, I0_k) o salidas de equipos de la escena (\"KM1.closed\") con su valor esperado.",
          "additionalProperties": {
            "type": [
              "number",
              "boolean"
            ]
          }
        },
        "console": {
          "type": "string",
          "description": "Expresión regular sobre las líneas de la consola."
        },
        "no_faults": {
          "const": true,
          "description": "Sin fallas eléctricas de la escena (cortocircuito, sobretensión)."
        },
        "period": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Señal (Q0_k, I0_k, <equipo>.<salida>)"
            },
            {
              "type": "object",
              "required": [
                "console"
              ],
              "additionalProperties": false,
              "properties": {
                "console": {
                  "type": "string",
                  "description": "Expresión regular sobre las líneas de la consola"
                }
              }
            }
          ],
          "description": "La señal (o la línea de la consola) se repite con un ritmo: cycle_ms, on_ms y/o off_ms."
        },
        "cycle_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "on_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "off_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Con period: cuántos ciclos seguidos (los últimos del intervalo)."
        },
        "responds": {
          "type": "object",
          "required": [
            "when",
            "expect"
          ],
          "additionalProperties": false,
          "description": "Cada vez que 'when' pasa a cumplirse, 'expect' se cumple dentro de within_ms.",
          "properties": {
            "when": {
              "type": "object",
              "minProperties": 1
            },
            "expect": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        "within_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "oneOf": [
        {
          "required": [
            "expect",
            "at_ms"
          ]
        },
        {
          "required": [
            "always"
          ]
        },
        {
          "required": [
            "never"
          ]
        },
        {
          "required": [
            "eventually"
          ]
        },
        {
          "required": [
            "console"
          ]
        },
        {
          "required": [
            "no_faults"
          ]
        },
        {
          "required": [
            "period"
          ]
        },
        {
          "required": [
            "responds",
            "within_ms"
          ]
        }
      ]
    },
    "goal": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "when": {
          "description": "Señal → valor (igualdad) o [min, max] (rango cerrado). Claves: I0_k, Q0_k, <equipo>.<salida>.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": [
                  "boolean",
                  "number"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        },
        "hold_ms": {
          "type": "number",
          "minimum": 0
        },
        "after": {
          "description": "id de un objetivo anterior que debe cumplirse primero",
          "type": "string"
        },
        "extra": {
          "description": "Objetivo extra: no impide completar el reto",
          "enum": [
            "merit",
            "distinction"
          ]
        },
        "console": {
          "type": "string",
          "description": "Expresión regular: una línea del Monitor Serie que coincide."
        },
        "period": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Señal (Q0_k, I0_k, <equipo>.<salida>)"
            },
            {
              "type": "object",
              "required": [
                "console"
              ],
              "additionalProperties": false,
              "properties": {
                "console": {
                  "type": "string",
                  "description": "Expresión regular sobre las líneas de la consola"
                }
              }
            }
          ],
          "description": "Ritmo de una señal o de una línea de la consola; con cycle_ms, on_ms u off_ms."
        },
        "cycle_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "on_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "off_ms": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "[min, max] en ms"
        },
        "cycles": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "hint": {
          "type": "string",
          "description": "Pista que el alumno puede abrir mientras no lo logra."
        },
        "why": {
          "type": "string",
          "description": "Qué enseña; se muestra al lograrlo."
        }
      },
      "anyOf": [
        {
          "required": [
            "when"
          ]
        },
        {
          "required": [
            "console"
          ]
        },
        {
          "required": [
            "period"
          ]
        }
      ]
    }
  }
}
