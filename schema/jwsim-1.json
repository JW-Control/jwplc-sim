{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "title": "Proyecto JWPLC Sim (.jwsim) v1",
  "description": "Vincula el sketch, el proyecto OpenPLC y la HMI con la configuración de simulación. Rutas relativas al archivo .jwsim. Los campos desconocidos se conservan.",
  "type": "object",
  "required": [
    "format",
    "version",
    "board",
    "program"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "jwsim"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "enum": [
            "jwplcbasic"
          ]
        },
        "package": {
          "type": "object",
          "properties": {
            "minRef": {
              "type": "string",
              "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "arduino",
            "openplc"
          ]
        },
        "sketch": {
          "$ref": "#/$defs/relPath",
          "pattern": "\\.ino$"
        },
        "project": {
          "description": "kind openplc (G6): carpeta del proyecto del OpenPLC Editor (con project.json).",
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "openplc": {
          "$ref": "#/$defs/relPath"
        },
        "hmi": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "realtimeFactor": {
          "type": "number",
          "minimum": 0
        },
        "costModel": {
          "type": "string"
        },
        "peripherals": {
          "type": "object"
        },
        "ioBridge": {
          "type": "object",
          "description": "Puente de E/S (G8): la bornera como esclavo Modbus TCP para Open Industry Project o FUXA.",
          "properties": {
            "present": { "type": "boolean" },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "listenHost": { "type": "string" }
          },
          "additionalProperties": false
        }
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "inputMode": {
          "enum": [
            "toggle",
            "push"
          ]
        },
        "inputs": {
          "type": "object",
          "description": "Nivel inicial de las entradas de bornera (I0_0..I0_7).",
          "patternProperties": {
            "^I0_[0-7]$": {
              "enum": [
                0,
                1
              ]
            }
          }
        },
        "devices": {
          "type": "array",
          "description": "Dispositivos de la escena (G7, schema/jwsim-scene-1.json).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
              },
              "version": {
                "type": "string"
              },
              "params": {
                "type": "object"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              }
            }
          }
        },
        "wiring": {
          "type": "array",
          "description": "Cables borne a borne: '<dispositivo>.<borne>'.",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "points": {
                "type": "array"
              }
            }
          }
        }
      }
    },
    "exercise": {
      "type": "object",
      "description": "Proyecto de ejercicio (G9): enunciado, rúbrica de calificación automática (schema/jwsim-rubric-1.json) y solución de referencia.",
      "required": [
        "rubric"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "description": "Dificultad (1 = inicial)."
        },
        "statement": {
          "$ref": "#/$defs/relPath",
          "description": "Enunciado en Markdown."
        },
        "rubric": {
          "$ref": "#/$defs/relPath",
          "description": "Rúbrica (jwsim-rubric-1.json)."
        },
        "solution": {
          "$ref": "#/$defs/relPath",
          "description": "Carpeta del sketch de referencia (para docentes y para validar la rúbrica)."
        }
      }
    },
    "stimuli": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "program": {
            "properties": {
              "kind": {
                "const": "arduino"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "program": {
            "required": [
              "sketch"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\)",
      "description": "Ruta relativa al .jwsim (no absoluta)."
    }
  }
}
