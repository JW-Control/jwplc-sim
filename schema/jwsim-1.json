{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "title": "Proyecto JWPLC Sim (.jwsim) v1",
  "description": "Vincula el sketch, el proyecto OpenPLC y la HMI con la configuración de simulación. Rutas relativas al archivo .jwsim. Los campos desconocidos se conservan.",
  "type": "object",
  "required": [
    "format",
    "version",
    "board",
    "program"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "format": {
      "const": "jwsim"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "board": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "enum": [
            "jwplcbasic"
          ]
        },
        "package": {
          "type": "object",
          "properties": {
            "minRef": {
              "type": "string",
              "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$"
            }
          }
        }
      }
    },
    "program": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "arduino",
            "openplc"
          ]
        },
        "sketch": {
          "$ref": "#/$defs/relPath",
          "pattern": "\\.ino$"
        },
        "project": {
          "description": "kind openplc (G6): carpeta del proyecto del OpenPLC Editor (con project.json).",
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "openplc": {
          "$ref": "#/$defs/relPath"
        },
        "hmi": {
          "$ref": "#/$defs/relPath"
        }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "realtimeFactor": {
          "type": "number",
          "minimum": 0
        },
        "costModel": {
          "type": "string"
        },
        "peripherals": {
          "type": "object"
        },
        "ioBridge": {
          "type": "object",
          "description": "Puente de E/S (G8): la bornera como esclavo Modbus TCP para Open Industry Project o FUXA.",
          "properties": {
            "present": {
              "type": "boolean"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "listenHost": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "inputMode": {
          "enum": [
            "toggle",
            "push"
          ]
        },
        "inputs": {
          "type": "object",
          "description": "Nivel inicial de las entradas de bornera (I0_0..I0_7).",
          "patternProperties": {
            "^I0_[0-7]$": {
              "enum": [
                0,
                1
              ]
            }
          }
        },
        "devices": {
          "type": "array",
          "description": "Dispositivos de la escena (G7, schema/jwsim-scene-1.json).",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "type": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
              },
              "version": {
                "type": "string"
              },
              "params": {
                "type": "object"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "rotation": {
                "enum": [
                  0,
                  90,
                  180,
                  270
                ]
              },
              "mount": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
              },
              "p3": {
                "type": "object",
                "description": "Lugar del equipo en la Planta 3D armada a mano (metros y grados). Sin p3 se acomoda solo.",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "r": {
                    "enum": [
                      0,
                      90,
                      180,
                      270
                    ]
                  }
                },
                "required": [
                  "x",
                  "z"
                ]
              }
            }
          }
        },
        "wiring": {
          "type": "array",
          "description": "Cables borne a borne: '<dispositivo>.<borne>'.",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "color": {
                "type": "string"
              },
              "points": {
                "type": "array"
              },
              "cable": {
                "type": "string",
                "description": "Id del cable multipolar (scene.cables) en que va este hilo. Solo dibujo: el simulador usa from/to."
              },
              "ref": {
                "type": "boolean",
                "description": "Se dibuja como referencia: un tramo corto en cada borne con su destino, sin el recorrido largo."
              }
            }
          }
        },
        "cables": {
          "type": "array",
          "description": "Cables multipolares: hilos entre dos equipos que se dibujan juntos en una funda (solo dibujo).",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string",
                "description": "Nombre o sección (p. ej. 4×1 mm² mando)."
              },
              "ref": {
                "type": "boolean",
                "description": "Se dibuja como referencia: sin el tronco, un rótulo en cada salida."
              }
            }
          }
        },
        "plant3d": {
          "type": "object",
          "description": "Planta 3D armada a mano: rejilla, lugar del tablero y piezas de ambiente sin E/S (barandas, plataformas, cercos, pisos).",
          "properties": {
            "grid": {
              "enum": [
                0.25,
                0.5
              ]
            },
            "panel": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                },
                "r": {
                  "enum": [
                    0,
                    90,
                    180,
                    270
                  ]
                }
              },
              "required": [
                "x",
                "z"
              ]
            },
            "pieces": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "kind",
                  "x",
                  "z"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
                  },
                  "kind": {
                    "enum": [
                      "plataforma",
                      "escalera",
                      "baranda",
                      "cerco",
                      "poste",
                      "franja",
                      "paso",
                      "piso",
                      "caja",
                      "pallet"
                    ]
                  },
                  "x": {
                    "type": "number"
                  },
                  "z": {
                    "type": "number"
                  },
                  "r": {
                    "enum": [
                      0,
                      90,
                      180,
                      270
                    ]
                  },
                  "params": {
                    "type": "object",
                    "description": "Medidas de la pieza (ancho, largo, alto en metros)."
                  }
                }
              }
            }
          }
        }
      }
    },
    "exercise": {
      "type": "object",
      "description": "Proyecto de ejercicio (G9): enunciado, rúbrica de calificación automática (schema/jwsim-rubric-1.json) y solución de referencia.",
      "required": [
        "rubric"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "description": "Dificultad (1 = inicial)."
        },
        "statement": {
          "$ref": "#/$defs/relPath",
          "description": "Enunciado en Markdown."
        },
        "rubric": {
          "$ref": "#/$defs/relPath",
          "description": "Rúbrica (jwsim-rubric-1.json)."
        },
        "solution": {
          "$ref": "#/$defs/relPath",
          "description": "Carpeta del sketch de referencia (para docentes y para validar la rúbrica)."
        },
        "brief": {
          "type": "object",
          "description": "Ficha del reto: se muestra antes de empezar y en el centro de aprendizaje.",
          "additionalProperties": false,
          "properties": {
            "goal": {
              "type": "string",
              "description": "Qué hay que lograr."
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Qué hacer, en orden."
            },
            "uses": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Señales y equipos con los que se trabaja."
            },
            "teaches": {
              "type": "string",
              "description": "Qué enseña (se muestra al completar el reto)."
            }
          }
        }
      }
    },
    "stimuli": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relPath"
      }
    },
    "diagnostico": {
      "type": "object",
      "description": "Modo Diagnóstico: órdenes de trabajo con una falla oculta que el alumno halla midiendo y repara (app/renderer/diagnostico.js).",
      "properties": {
        "ordenes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "titulo",
              "sintoma",
              "falla"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "titulo": {
                "type": "string",
                "description": "Lo que se ve en la orden (sin delatar la causa)."
              },
              "sintoma": {
                "type": "string",
                "description": "Lo que reporta el operador."
              },
              "falla": {
                "type": "object",
                "description": "Falla de la escena (Scene.inject): {kind: open, wire: \"A.x B.y\"} o {kind: stuck|burnt|welded, device, value?}.",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "open",
                      "stuck",
                      "burnt",
                      "welded"
                    ]
                  },
                  "wire": {
                    "type": "string"
                  },
                  "device": {
                    "type": "string"
                  },
                  "value": {
                    "type": "boolean"
                  }
                }
              },
              "causa": {
                "type": "string",
                "description": "Explicación que se muestra al cerrar la orden."
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "program": {
            "properties": {
              "kind": {
                "const": "arduino"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "program": {
            "required": [
              "sketch"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\)",
      "description": "Ruta relativa al .jwsim (no absoluta)."
    }
  }
}
