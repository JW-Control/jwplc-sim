{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "title": "Proyecto JWPLC Sim (.jwsim) v1",
  "description": "Vincula el sketch, el proyecto OpenPLC y la HMI con la configuración de simulación. Rutas relativas al archivo .jwsim. Los campos desconocidos se conservan.",
  "type": "object",
  "required": ["format", "version", "board", "program"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "jwsim" },
    "version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "board": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "enum": ["jwplcbasic"] },
        "package": {
          "type": "object",
          "properties": { "minRef": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.]+)?$" } }
        }
      }
    },
    "program": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["arduino", "openplc"] },
        "sketch": { "$ref": "#/$defs/relPath", "pattern": "\\.ino$" }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "openplc": { "$ref": "#/$defs/relPath" },
        "hmi": { "$ref": "#/$defs/relPath" }
      }
    },
    "simulation": {
      "type": "object",
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "realtimeFactor": { "type": "number", "minimum": 0 },
        "costModel": { "type": "string" },
        "peripherals": { "type": "object" }
      }
    },
    "scene": {
      "type": "object",
      "properties": {
        "inputMode": { "enum": ["toggle", "push"] },
        "inputs": {
          "type": "object",
          "description": "Nivel inicial de las entradas de bornera (I0_0..I0_7).",
          "patternProperties": { "^I0_[0-7]$": { "enum": [0, 1] } }
        },
        "devices": { "type": "array", "items": { "type": "object", "required": ["id", "type"] } },
        "wiring": { "type": "array", "items": { "type": "object", "required": ["from", "to"] } }
      }
    },
    "exercise": { "type": "object" },
    "stimuli": { "type": "array", "items": { "$ref": "#/$defs/relPath" } }
  },
  "allOf": [
    {
      "if": { "properties": { "program": { "properties": { "kind": { "const": "arduino" } } } } },
      "then": { "properties": { "program": { "required": ["sketch"] } } }
    }
  ],
  "$defs": {
    "relPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:|/|\\\\)",
      "description": "Ruta relativa al .jwsim (no absoluta)."
    }
  }
}
