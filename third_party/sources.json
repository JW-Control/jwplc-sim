      "patches": {
        "TFT_Drivers/ST7789_Init.h": {
          "why": "Mismo cambio que el libJWPLC_TFT.a de alpha.13 (gate A13-TFT-PRE4/PRE6, validado en placa): con JWPLC_TFT_DEFER_DISPON (tft_setup.h) el init de TFT_eSPI termina con la pantalla apagada y JWPLC_TFT la enciende después de limpiar la memoria a negro. Sin él se ve el rojo de fillScreen(TFT_RED) del init al arrancar. Las líneas insertadas llevan CRLF, como el archivo validado.",
          "find": "^(?<indent>\\s*)writecommand\\(ST7789_DISPON\\);\\s*//\\s*Display on\\s*\\r?\\n\\k<indent>delay\\(120\\);",
          "flags": "gm",
          "replace": "$<indent>#ifndef JWPLC_TFT_DEFER_DISPON\r\n$<indent>writecommand(ST7789_DISPON);    // Display on\r\n$<indent>delay(120);\r\n$<indent>#endif",
          "count": 2,
          "sha256": "44873be82fe836084934a328df77f098e9ab88d212dd1d570da5e8aac74671bc"
        }
      }
    }
