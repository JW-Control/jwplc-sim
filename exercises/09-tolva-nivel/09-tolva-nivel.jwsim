{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Nivel de una tolva con descarga por gravedad",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/tolva_nivel/tolva_nivel.ino"
  },
  "exercise": {
    "level": 3,
    "statement": "./ENUNCIADO.md",
    "rubric": "./rubrica.json",
    "solution": "./solucion/tolva_nivel",
    "brief": {
      "goal": "Mantener una tolva con descarga por gravedad entre B1 (30 %) y B2 (80 %) mientras el proceso está habilitado.",
      "steps": [
        "Con S1 en 0 todo detenido; con S1 en I abra la descarga Y1.",
        "Arranque la bomba bajo B1 y párela al llegar a B2 (histéresis).",
        "Si S1 vuelve a 0, pare la bomba y cierre Y1.",
        "H1 encendido con el agua bajo B1."
      ],
      "teaches": "Histéresis con un proceso continuo (tanque discretizado) y habilitación por selector.",
      "uses": [
        "I0_0 · B1, sensor capacitivo al 30 % de la altura: Detecta: hay agua a la altura de B1",
        "I0_1 · B2, sensor capacitivo al 80 % de la altura: Detecta: tolva llena",
        "I0_2 · S1, selector «Habilitar»: En I: el proceso está habilitado",
        "Q0_0 · KM1, contactor: Bomba M1 (230 VAC)",
        "Q0_1 · Y1, electroválvula de descarga: Abierta: la tolva entrega agua al proceso",
        "Q0_2 · H1, piloto rojo: Nivel bajo"
      ]
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
