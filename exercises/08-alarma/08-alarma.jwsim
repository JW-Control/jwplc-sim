{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Alarma con reconocimiento",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/alarma/alarma.ino"
  },
  "exercise": {
    "level": 3,
    "statement": "./ENUNCIADO.md",
    "rubric": "./rubrica.json",
    "solution": "./solucion/alarma"
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 300,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 40,
        "y": 60
      },
      {
        "id": "B1",
        "type": "jwsim/limit-switch",
        "x": 300,
        "y": -700
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "label": "Reconocer",
          "color": "amarillo"
        },
        "x": 500,
        "y": -280
      },
      {
        "id": "HA1",
        "type": "jwsim/buzzer",
        "x": 240,
        "y": 620
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "rojo",
          "label": "Alarma"
        },
        "x": 440,
        "y": 620
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V1",
        "to": "B1.13"
      },
      {
        "from": "B1.14",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_1"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "HA1.+"
      },
      {
        "from": "HA1.-",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2"
      }
    ]
  }
}
