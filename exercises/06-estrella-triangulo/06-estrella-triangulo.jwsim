{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Arranque estrella-triángulo",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/estrella_triangulo/estrella_triangulo.ino"
  },
  "exercise": {
    "level": 2,
    "statement": "./ENUNCIADO.md",
    "rubric": "./rubrica.json",
    "solution": "./solucion/estrella_triangulo",
    "brief": {
      "goal": "Arrancar un motor en estrella y pasar a triángulo a los 3 s, con la pausa obligatoria entre ambos.",
      "steps": [
        "Con S1 cierre KM1 (línea) y KM2 (estrella).",
        "A los 3 s abra KM2, espere 100 ms y cierre KM3 (triángulo).",
        "KM2 y KM3 nunca juntos, ni un instante.",
        "S0 abre los tres; H1 encendido en marcha."
      ],
      "teaches": "Secuencia temporizada con pausa obligatoria entre contactores.",
      "uses": [
        "I0_0 · S1, pulsador NA: Marcha",
        "I0_1 · S0, pulsador NC: Parada (1 = sin pulsar)",
        "Q0_0 · KM1, contactor: Línea",
        "Q0_1 · KM2, contactor: Estrella",
        "Q0_2 · KM3, contactor: Triángulo",
        "Q0_3 · H1, piloto verde: En marcha"
      ]
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
