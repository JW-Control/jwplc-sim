{
  "$schema": "https://jw-control.github.io/jwplc-sim/schema/jwsim-1.json",
  "format": "jwsim",
  "version": 1,
  "name": "Marcha y parada con enclavamiento",
  "board": {
    "id": "jwplcbasic",
    "package": {
      "minRef": "v2.1.0-alpha.13"
    }
  },
  "program": {
    "kind": "arduino",
    "sketch": "./sketch/marcha_parada/marcha_parada.ino"
  },
  "exercise": {
    "level": 1,
    "statement": "./ENUNCIADO.md",
    "rubric": "./rubrica.json",
    "solution": "./solucion/marcha_parada",
    "brief": {
      "goal": "Un motor que arranca con S1, sigue en marcha al soltarlo y se detiene con S0.",
      "steps": [
        "Lea las entradas S1 (marcha) y S0 (parada, NC).",
        "Enclave KM1 al pulsar S1 (autorretención).",
        "Abra KM1 con S0; si se pulsan los dos, gana la parada.",
        "Encienda H1 mientras el motor gira.",
        "Ejecute y pruébelo con los pulsadores de la escena."
      ],
      "teaches": "Autorretención, prioridad de la parada y por qué la parada es NC (falla segura).",
      "uses": [
        "I0_0 · S1, pulsador NA verde: Marcha",
        "I0_1 · S0, pulsador NC rojo: Parada (1 = sin pulsar)",
        "Q0_0 · KM1, contactor: Motor M1 (230 VAC)",
        "Q0_1 · H1, piloto verde: Motor en marcha"
      ]
    }
  },
  "simulation": {
    "seed": 1,
    "realtimeFactor": 1
  },
  "scene": {
    "devices": [
      {
        "id": "plc",
        "type": "jwsim/jwplc-basic",
        "x": 240,
        "y": 0
      },
      {
        "id": "PS1",
        "type": "jwsim/power-24vdc",
        "params": {
          "model": "MDR-60"
        },
        "x": 0,
        "y": 0
      },
      {
        "id": "S1",
        "type": "jwsim/pushbutton-no",
        "params": {
          "label": "Marcha",
          "color": "verde"
        },
        "x": 760,
        "y": 0
      },
      {
        "id": "S0",
        "type": "jwsim/pushbutton-nc",
        "params": {
          "label": "Parada",
          "color": "rojo"
        },
        "x": 920,
        "y": 0
      },
      {
        "id": "KM1",
        "type": "jwsim/contactor",
        "x": 1180,
        "y": 0
      },
      {
        "id": "H1",
        "type": "jwsim/lamp",
        "params": {
          "color": "verde",
          "label": "Marcha"
        },
        "x": 1400,
        "y": 0
      },
      {
        "id": "L1",
        "type": "jwsim/power-230vac",
        "x": 0,
        "y": 440
      },
      {
        "id": "M1",
        "type": "jwsim/motor",
        "x": 1180,
        "y": 420
      }
    ],
    "wiring": [
      {
        "from": "PS1.+V1",
        "to": "plc.24VDC"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M0"
      },
      {
        "from": "PS1.-V1",
        "to": "plc.M1"
      },
      {
        "from": "PS1.+V1",
        "to": "S1.13"
      },
      {
        "from": "S1.14",
        "to": "plc.I0_0"
      },
      {
        "from": "PS1.+V1",
        "to": "S0.11"
      },
      {
        "from": "S0.12",
        "to": "plc.I0_1"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_0.1"
      },
      {
        "from": "plc.Q0_0.2",
        "to": "KM1.A1"
      },
      {
        "from": "KM1.A2",
        "to": "PS1.-V2"
      },
      {
        "from": "PS1.+V1",
        "to": "plc.Q0_1.1"
      },
      {
        "from": "plc.Q0_1.2",
        "to": "H1.X1"
      },
      {
        "from": "H1.X2",
        "to": "PS1.-V2"
      },
      {
        "from": "L1.L",
        "to": "KM1.1"
      },
      {
        "from": "KM1.2",
        "to": "M1.U1"
      },
      {
        "from": "M1.U2",
        "to": "L1.N"
      }
    ]
  }
}
